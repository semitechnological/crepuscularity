{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Crepus",
  "scopeName": "source.crepus",
  "patterns": [
    { "include": "#comment" },
    { "include": "#frontmatter" },
    { "include": "#section" },
    { "include": "#jsx" },
    { "include": "#string" },
    { "include": "#element_tokens" },
    { "include": "#directive" },
    { "include": "#keyword" },
    { "include": "#expr" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "comment": "Line comment only when # is the first non-whitespace (avoids stealing #id on element lines).",
          "name": "comment.line.number-sign.crepus",
          "match": "^[\\t ]*#.*$"
        }
      ]
    },
    "frontmatter": {
      "patterns": [
        {
          "name": "meta.embedded.block.crepus",
          "begin": "^\\+\\+\\+$",
          "end": "^\\+\\+\\+$",
          "beginCaptures": { "0": { "name": "punctuation.section.crepus" } },
          "endCaptures": { "0": { "name": "punctuation.crepus" } },
          "contentName": "meta.frontmatter.crepus"
        }
      ]
    },
    "section": {
      "patterns": [
        {
          "name": "entity.name.section.crepus",
          "match": "^---\\s+.+$"
        }
      ]
    },
    "jsx": {
      "patterns": [
        {
          "name": "meta.tag.crepus",
          "begin": "(</?)([a-zA-Z][a-zA-Z0-9\\-]*)",
          "end": "(/?>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.crepus" },
            "2": { "name": "entity.name.tag.crepus" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.crepus" }
          },
          "patterns": [
            {
              "name": "entity.other.attribute-name.html.crepus",
              "match": "\\b([a-zA-Z@\\-][a-zA-Z0-9\\-:@]*)\\b(?=\\s*=)"
            },
            { "include": "#string" },
            { "include": "#expr" }
          ]
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.crepus",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.crepus",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "element_tokens": {
      "patterns": [
        {
          "comment": "Tag only (no trailing classes).",
          "match": "^([\\t ]*)([^\\s#\"<]+)$",
          "captures": {
            "1": { "name": "punctuation.whitespace.indent.crepus" },
            "2": { "name": "entity.name.tag.crepus" }
          }
        },
        {
          "comment": "Indent-style line: first word is the element / keyword, then class / attr segments.",
          "begin": "^([\\t ]*)([^\\s#\"<]+)([\\t ]+)",
          "end": "$",
          "beginCaptures": {
            "1": { "name": "punctuation.whitespace.indent.crepus" },
            "2": { "name": "entity.name.tag.crepus" }
          },
          "patterns": [{ "include": "#class_segment_inline" }]
        }
      ]
    },
    "class_segment_inline": {
      "patterns": [
        { "match": "\\s+" },
        {
          "comment": "Quoted attribute assignment with double quotes, e.g. href=\"/docs\".",
          "begin": "([@a-zA-Z][a-zA-Z0-9_.:-]*)(=)(\")",
          "beginCaptures": {
            "1": { "name": "entity.other.attribute-name.html.crepus" },
            "2": { "name": "punctuation.separator.key-value.html.crepus" },
            "3": { "name": "punctuation.definition.string.begin.crepus" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.crepus" }
          },
          "contentName": "string.quoted.double.attribute-value.crepus",
          "patterns": [
            {
              "name": "constant.character.escape.crepus",
              "match": "\\\\."
            }
          ]
        },
        {
          "comment": "Quoted attribute assignment with single quotes, e.g. href='/docs'.",
          "begin": "([@a-zA-Z][a-zA-Z0-9_.:-]*)(=)(')",
          "beginCaptures": {
            "1": { "name": "entity.other.attribute-name.html.crepus" },
            "2": { "name": "punctuation.separator.key-value.html.crepus" },
            "3": { "name": "punctuation.definition.string.begin.crepus" }
          },
          "end": "'",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.crepus" }
          },
          "contentName": "string.quoted.single.attribute-value.crepus",
          "patterns": [
            {
              "name": "constant.character.escape.crepus",
              "match": "\\\\."
            }
          ]
        },
        {
          "comment": "`onclick={handler}` before bare `{expr}` so the `=` form wins.",
          "begin": "([@a-zA-Z][a-zA-Z0-9_.:-]*)(=)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "entity.other.attribute-name.html.crepus" },
            "2": { "name": "punctuation.separator.key-value.html.crepus" },
            "3": { "name": "punctuation.section.embedded.begin.crepus" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.binding.end.crepus" }
          },
          "contentName": "source.embedded.line.crepus",
          "patterns": [{ "include": "#string" }]
        },
        {
          "comment": "Bare `{binding}` segment.",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.crepus" } },
          "endCaptures": { "0": { "name": "punctuation.section.embedded.end.crepus" } },
          "contentName": "source.embedded.line.crepus"
        },
        {
          "comment": "Unquoted attribute assignment, e.g. rel=noreferrer.",
          "match": "([@a-zA-Z][a-zA-Z0-9_.:-]*)(=)([^\\s]+)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.html.crepus" },
            "2": { "name": "punctuation.separator.key-value.html.crepus" },
            "3": { "name": "string.unquoted.attribute-value.crepus" }
          }
        },
        {
          "name": "entity.other.attribute-name.id.crepus",
          "match": "#[a-zA-Z0-9_-]+"
        },
        {
          "comment": "Tailwind-style variant:utility (utility's first char is not / so https:// is not split).",
          "match": "([a-zA-Z0-9_\\[\\]-]+)(:)([^\\s/][^\\s]*)",
          "captures": {
            "1": { "name": "keyword.other.variant.crepus" },
            "2": { "name": "punctuation.separator.sequence.crepus" },
            "3": { "name": "entity.other.attribute-name.crepus" }
          }
        },
        {
          "name": "entity.other.attribute-name.crepus",
          "match": "[^\\s]+"
        }
      ]
    },
    "directive": {
      "patterns": [
        {
          "name": "keyword.operator.declaration.crepus",
          "match": "^\\$:\\s*(let|default)\\b"
        },
        {
          "name": "keyword.control.import.crepus",
          "match": "^include\\s+"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.crepus",
          "match": "^(if|else|else if|for|match)\\b"
        },
        {
          "name": "keyword.control.crepus",
          "match": "\\b(slug|match|then|=>)\\b"
        }
      ]
    },
    "expr": {
      "patterns": [
        {
          "name": "punctuation.section.embedded.crepus",
          "match": "\\(\\.\\.\\.\\)"
        },
        {
          "name": "punctuation.section.embedded.begin.crepus",
          "match": "\\("
        },
        {
          "name": "punctuation.section.embedded.end.crepus",
          "match": "\\)"
        },
        {
          "name": "meta.embedded.expr.crepus",
          "begin": "\\{",
          "end": "\\}",
          "contentName": "source.embedded.crepus"
        }
      ]
    }
  }
}
