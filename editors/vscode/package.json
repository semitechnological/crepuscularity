{
  "name": "crepuscularity-vscode",
  "displayName": "Crepuscularity",
  "description": "Syntax highlighting, snippets, and crepus-lsp diagnostics for .crepus templates.",
  "version": "0.1.0",
  "publisher": "crepuscularity",
  "author": "Max Carter <max@undivisible.dev>",
  "license": "MPL-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "packageManager": "bun@1.3.1",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:crepus"
  ],
  "contributes": {
    "languages": [
      {
        "id": "crepus",
        "aliases": ["Crepuscularity", "crepus"],
        "extensions": [".crepus"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "crepus",
        "scopeName": "source.crepus",
        "path": "./syntaxes/crepus.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "crepus",
        "path": "./snippets/crepus.json"
      }
    ],
    "configuration": {
      "title": "Crepuscularity",
      "properties": {
        "crepus.languageServerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the crepus-lsp executable. When empty, uses crepus-lsp on PATH, then <workspace>/target/debug/crepus-lsp."
        }
      }
    },
    "commands": [
      {
        "command": "crepus.restartLanguageServer",
        "title": "Crepus: Restart Language Server"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "bun run compile",
    "lint": "bun x eslint src --ext ts || true"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.3"
  }
}
