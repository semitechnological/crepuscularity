{
  "div": {
    "prefix": "div",
    "body": ["div ${1:class-names}", "  \"$0\""],
    "description": "Div with text child"
  },
  "if": {
    "prefix": "if",
    "body": ["if {${1:condition}}", "  ${0}"],
    "description": "if block"
  },
  "for": {
    "prefix": "for",
    "body": ["for ${1:item} in {${2:list}}", "  ${0}"],
    "description": "for loop"
  },
  "include": {
    "prefix": "include",
    "body": ["include ${1:path.crepus}${2:#Component}", "  ${0}"],
    "description": "include component"
  },
  "jsx-div": {
    "prefix": "jdiv",
    "body": ["<div class=\"${1:classes}\">", "  ${0}", "</div>"],
    "description": "JSX div"
  },
  "let": {
    "prefix": "let",
    "body": ["$: let ${1:name} = {${2:expr}}"],
    "description": "$: let declaration"
  }
}
