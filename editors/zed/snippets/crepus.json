{
  "div": {
    "prefix": "div",
    "body": ["div ${1:class}", "  \"$0\""],
    "description": "Crepus div block"
  },
  "if": {
    "prefix": "if",
    "body": ["if {${1:condition}}", "  $0"],
    "description": "Crepus if block"
  },
  "for": {
    "prefix": "for",
    "body": ["for ${1:item} in {${2:list}}", "  $0"],
    "description": "Crepus for loop"
  },
  "include": {
    "prefix": "include",
    "body": ["include ${1:file.crepus}${2:#Name}", "  $0"],
    "description": "Crepus include statement"
  }
}
