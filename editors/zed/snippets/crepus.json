{
  "div": {
    "prefix": "div",
    "body": ["div ${1:class}", "  \"$0\""],
    "description": "Crepus div block"
  },
  "span": {
    "prefix": "span",
    "body": ["span ${1:class}", "  \"$0\""],
    "description": "Crepus span inline"
  },
  "button": {
    "prefix": "button",
    "body": ["button ${1:class}", "  \"$0\""],
    "description": "Crepus button"
  },
  "input": {
    "prefix": "input",
    "body": ["input ${1:class}", "  \"$0\""],
    "description": "Crepus input"
  },
  "if": {
    "prefix": "if",
    "body": ["if {${1:condition}}", "  $0"],
    "description": "Crepus if block"
  },
  "else": {
    "prefix": "else",
    "body": ["else", "  $0"],
    "description": "Crepus else branch"
  },
  "else-if": {
    "prefix": "else-if",
    "body": ["else-if {${1:condition}}", "  $0"],
    "description": "Crepus else-if branch"
  },
  "for": {
    "prefix": "for",
    "body": ["for ${1:item} in {${2:list}}", "  $0"],
    "description": "Crepus for loop"
  },
  "match": {
    "prefix": "match",
    "body": ["match {${1:expression}}", "  $0"],
    "description": "Crepus match block"
  },
  "include": {
    "prefix": "include",
    "body": ["include ${1:file.crepus}${2:#Name}", "  $0"],
    "description": "Crepus include statement"
  },
  "slot": {
    "prefix": "slot",
    "body": ["slot", "  $0"],
    "description": "Crepus slot render"
  },
  "slot-rotate": {
    "prefix": "slot-rotate",
    "body": ["slot-rotate interval={${1:1000}}", "  \"$0\""],
    "description": "Crepus rotating slot"
  },
  "let": {
    "prefix": "let",
    "body": ["$: let ${1:name} = {$0}"],
    "description": "Crepus let binding"
  },
  "let-default": {
    "prefix": "let-default",
    "body": ["$: default ${1:name} = ${2:value}"],
    "description": "Crepus default prop"
  }
}
