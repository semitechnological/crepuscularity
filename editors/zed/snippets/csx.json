    "body": ["<View class=\"${1:flex-1}\">$0</View>"],
    "description": "React Native View"
  },
  "Text": {
    "prefix": "Text",
    "body": ["<Text class=\"${1:text-base}\">$0</Text>"],
    "description": "React Native Text"
  },
  "Image": {
    "prefix": "Image",
    "body": ["<Image source={require(\"${1:./image.png}\")} class=\"${2:w-full h-48}\" />"],
    "description": "React Native Image"
  },
  "ScrollView": {
    "prefix": "ScrollView",
    "body": ["<ScrollView class=\"${1:flex-1}\">$0</ScrollView>"],
    "description": "React Native ScrollView"
  },
