{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "crepus",
  "rules": {
    "template": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "logical_line"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "_eol"
                  }
                ]
              },
              {
                "type": "SYMBOL",
                "name": "_eol"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "logical_line"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_eol": {
      "type": "STRING",
      "value": "\n"
    },
    "logical_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "fragment_section"
        },
        {
          "type": "SYMBOL",
          "name": "frontmatter_marker"
        },
        {
          "type": "SYMBOL",
          "name": "jsx_fragment"
        },
        {
          "type": "SYMBOL",
          "name": "quoted"
        },
        {
          "type": "SYMBOL",
          "name": "element_line"
        }
      ]
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "#"
          },
          {
            "type": "PATTERN",
            "value": "[^\\n]*"
          }
        ]
      }
    },
    "frontmatter_marker": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "+++"
      }
    },
    "fragment_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "---"
        },
        {
          "type": "PATTERN",
          "value": "[^\\n]+"
        }
      ]
    },
    "jsx_fragment": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "<"
            },
            {
              "type": "PATTERN",
              "value": "[^>\\n]+"
            },
            {
              "type": "STRING",
              "value": ">"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "</"
            },
            {
              "type": "PATTERN",
              "value": "[^>\\n]+"
            },
            {
              "type": "STRING",
              "value": ">"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "<"
            },
            {
              "type": "PATTERN",
              "value": "[^>\\n]+"
            },
            {
              "type": "STRING",
              "value": "/>"
            }
          ]
        }
      ]
    },
    "quoted": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "TOKEN",
                "content": {
                  "type": "PREC",
                  "value": 1,
                  "content": {
                    "type": "PATTERN",
                    "value": "\\\\."
                  }
                }
              },
              {
                "type": "PATTERN",
                "value": "[^\"\\\\]"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "element_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "tag",
          "content": {
            "type": "SYMBOL",
            "name": "element_tag"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "FIELD",
            "name": "class",
            "content": {
              "type": "SYMBOL",
              "name": "class_segment"
            }
          }
        }
      ]
    },
    "element_tag": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\"<\\s#\\n]+"
      }
    },
    "class_segment": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "braced_expression"
        },
        {
          "type": "SYMBOL",
          "name": "hash_id"
        },
        {
          "type": "SYMBOL",
          "name": "attr_binding_braced"
        },
        {
          "type": "SYMBOL",
          "name": "attr_name_only"
        },
        {
          "type": "SYMBOL",
          "name": "tailwind_pair"
        },
        {
          "type": "SYMBOL",
          "name": "plain_class"
        }
      ]
    },
    "braced_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "FIELD",
          "name": "body",
          "content": {
            "type": "SYMBOL",
            "name": "braced_body"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "braced_body": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^}\\n]*"
      }
    },
    "hash_id": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "#"
          },
          {
            "type": "PATTERN",
            "value": "[a-zA-Z0-9_-]+"
          }
        ]
      }
    },
    "attr_binding_braced": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "attr",
            "content": {
              "type": "SYMBOL",
              "name": "attr_name_eq"
            }
          },
          {
            "type": "FIELD",
            "name": "value",
            "content": {
              "type": "SYMBOL",
              "name": "braced_expression"
            }
          }
        ]
      }
    },
    "attr_name_only": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SYMBOL",
        "name": "attr_name_eq"
      }
    },
    "attr_name_eq": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "PATTERN",
              "value": "[@a-zA-Z][a-zA-Z0-9_.-]*"
            },
            {
              "type": "STRING",
              "value": "="
            }
          ]
        }
      }
    },
    "tailwind_pair": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "TOKEN",
        "content": {
          "type": "PATTERN",
          "value": "[a-zA-Z0-9_\\[\\]-]+:[^\"<\\s\\/\\n][^\"<\\s\\n]*"
        }
      }
    },
    "plain_class": {
      "type": "PREC",
      "value": -1,
      "content": {
        "type": "TOKEN",
        "content": {
          "type": "PREC",
          "value": -2,
          "content": {
            "type": "PATTERN",
            "value": "[^\"<\\s\\n]+"
          }
        }
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[\\t\\f\\v ]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
