{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "crepus",
  "rules": {
    "template": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "logical_line"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "_eol"
                  }
                ]
              },
              {
                "type": "SYMBOL",
                "name": "_eol"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "logical_line"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_eol": {
      "type": "STRING",
      "value": "\n"
    },
    "logical_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "fragment_section"
        },
        {
          "type": "SYMBOL",
          "name": "frontmatter_marker"
        },
        {
          "type": "SYMBOL",
          "name": "jsx_fragment"
        },
        {
          "type": "SYMBOL",
          "name": "quoted"
        },
        {
          "type": "SYMBOL",
          "name": "element_line"
        }
      ]
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "#"
          },
          {
            "type": "PATTERN",
            "value": "[^\\n]*"
          }
        ]
      }
    },
    "frontmatter_marker": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "+++"
      }
    },
    "fragment_section": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "---"
        },
        {
          "type": "PATTERN",
          "value": "[^\\n]+"
        }
      ]
    },
    "jsx_fragment": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "<"
            },
            {
              "type": "PATTERN",
              "value": "[^>\\n]+"
            },
            {
              "type": "STRING",
              "value": ">"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "</"
            },
            {
              "type": "PATTERN",
              "value": "[^>\\n]+"
            },
            {
              "type": "STRING",
              "value": ">"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "<"
            },
            {
              "type": "PATTERN",
              "value": "[^>\\n]+"
            },
            {
              "type": "STRING",
              "value": "/>"
            }
          ]
        }
      ]
    },
    "quoted": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "TOKEN",
                "content": {
                  "type": "PREC",
                  "value": 1,
                  "content": {
                    "type": "PATTERN",
                    "value": "\\\\."
                  }
                }
              },
              {
                "type": "PATTERN",
                "value": "[^\"\\\\]"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "element_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "tag",
          "content": {
            "type": "SYMBOL",
            "name": "element_tag"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "FIELD",
            "name": "class",
            "content": {
              "type": "SYMBOL",
              "name": "element_class"
            }
          }
        }
      ]
    },
    "element_tag": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\"<\\s#\\n]+"
      }
    },
    "element_class": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\"<\\s\\n]+"
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[\\t\\f\\v ]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
