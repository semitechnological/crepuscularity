$: default label = "Transfer"
$: default fileName = ""
$: default value = 0
$: default max = 100
$: default speed = ""
$: default eta = ""
$: default showSpeed = true
$: default showEta = true

$: let percent = {value / max * 100}

div flex flex-col gap-2 p-4 border border-zinc-700 rounded-lg bg-zinc-900
  div flex justify-between items-center
    div font-semibold text-white
      "{label}"
    if {fileName}
      div text-sm text-zinc-400
        "{fileName}"
  progress value={value} max={max} w-full h-2
  div flex justify-between text-sm text-zinc-400
    div
      "{percent}%"
    if {showSpeed && speed}
      div
        "{speed}/s"
    if {showEta && eta}
      div
        "{eta} remaining"
