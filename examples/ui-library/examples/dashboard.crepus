div w-full h-full bg-zinc-950 text-white p-8 flex flex-col gap-6
  div text-2xl font-bold
    "Dashboard"
  include ui-library.crepus#Tabs active=0 tabs={tabs}
  div grid grid-cols-3 gap-4
    include ui-library.crepus#Card title="Photos" subtitle="+3%"
      div text-3xl font-bold
        "12,405"
    include ui-library.crepus#Card title="Storage" subtitle="82%"
      div text-3xl font-bold
        "842 GB"
    include ui-library.crepus#Card title="Devices" subtitle="online"
      div text-3xl font-bold
        "4"
  div grid grid-cols-2 gap-4
    include ui-library.crepus#Panel title="Recent Files" collapsible=true defaultExpanded=true
      include ui-library.crepus#List items={recent}
    include ui-library.crepus#Panel title="Status" collapsible=true defaultExpanded=true
      div flex flex-col gap-2
        include ui-library.crepus#Badge label="online" color="green"
        include ui-library.crepus#Alert message="Sync is up to date" kind="success"
