div w-full h-full bg-zinc-950 text-white p-8 flex flex-col gap-8
  div text-2xl font-bold
    "UI Library"

  div flex flex-col gap-3
    div text-lg font-semibold text-zinc-300
      "Badges & Buttons"
    div flex flex-row gap-3 items-center
      include ui-library.crepus#Badge label="info"
      include ui-library.crepus#Badge label="active" color="green"
      include ui-library.crepus#Badge label="warning" color="yellow"
      include ui-library.crepus#Badge label="error" color="red"
    div flex flex-row gap-3 items-center
      include ui-library.crepus#Button label="Primary" variant="primary"
      include ui-library.crepus#Button label="Danger" variant="danger"
      include ui-library.crepus#Button label="Ghost" variant="ghost"
      include ui-library.crepus#Button label="Default"

  div flex flex-col gap-3
    div text-lg font-semibold text-zinc-300
      "Alerts"
    include ui-library.crepus#Alert message="Everything looks good" kind="success"
    include ui-library.crepus#Alert message="Deployment is pending" kind="warning"
    include ui-library.crepus#Alert message="Connection failed" kind="error"
    include ui-library.crepus#Alert message="New version available" kind="info"

  div flex flex-col gap-3
    div text-lg font-semibold text-zinc-300
      "Cards"
    include ui-library.crepus#Card title="Account" subtitle="Personal details"
      div text-zinc-400 text-sm
        "Card content goes here."

  div flex flex-col gap-3
    div text-lg font-semibold text-zinc-300
      "Tabs"
    include ui-library.crepus#Tabs active=1 tabs={tabs}

  div flex flex-col gap-3
    div text-lg font-semibold text-zinc-300
      "List"
    include ui-library.crepus#List items={items}

  div flex flex-col gap-3
    div text-lg font-semibold text-zinc-300
      "Wizard"
    include ui-library.crepus#Wizard currentStep=1 showProgress=true steps={steps}
      div p-4
        "Step content."

  div flex flex-col gap-3
    div text-lg font-semibold text-zinc-300
      "Grid"
    include ui-library.crepus#Grid columns=3 gap-4
      for photo in {photos}
        div aspect-square rounded-lg overflow-hidden bg-zinc-800
          img src={photo.thumb} alt={photo.title} object-cover w-full h-full

  div flex flex-col gap-3
    div text-lg font-semibold text-zinc-300
      "Avatar & Empty State"
    div flex flex-row gap-3 items-center
      include ui-library.crepus#Avatar label="A" size="sm"
      include ui-library.crepus#Avatar label="AB" size="md"
      include ui-library.crepus#Avatar label="ABC" size="lg"
    include ui-library.crepus#EmptyState message="No items found" action="Create one"
