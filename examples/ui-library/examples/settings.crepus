div w-full h-full bg-zinc-950 text-white p-8 flex flex-col gap-6
  div text-2xl font-bold
    "Settings"
  include ui-library.crepus#Panel title="General" collapsible=true defaultExpanded=true
    div flex flex-col gap-4
      label flex items-center gap-3
        input type="checkbox" checked=true
        "Enable sync"
      label flex items-center gap-3
        input type="checkbox" checked=false
        "Start on login"
  include ui-library.crepus#Panel title="Storage" collapsible=true defaultExpanded=false
    div flex flex-col gap-4
      label text-sm text-zinc-400
        "Quota"
      input type="range" min=0 max=100 value=50
  include ui-library.crepus#Panel title="Danger Zone" collapsible=true defaultExpanded=false
    div flex flex-col gap-3
      include ui-library.crepus#Button label="Reset" variant="danger"
      include ui-library.crepus#Alert message="This cannot be undone" kind="warning"
