div w-full h-full bg-zinc-950 text-white p-8 flex flex-col gap-6
  div text-2xl font-bold
    "Files"
  div flex flex-row gap-3 items-center
    include ui-library.crepus#Button label="Upload" variant="primary"
    include ui-library.crepus#Button label="Delete" variant="danger"
    include ui-library.crepus#Badge label="4 items" color="blue"
  include ui-library.crepus#List items={files}
