+++
[Grid]
description = "Responsive grid layout with configurable columns, gap, and item aspect ratio"

[Grid.defaults]
columns = 3
gap = 4
aspectRatio = "square"

[Panel]
description = "Collapsible panel with header and content slot"

[Panel.defaults]
title = "Panel"
collapsible = true
defaultExpanded = true

[Wizard]
description = "Multi-step wizard with progress bar and navigation"

[Wizard.defaults]
currentStep = 0
showProgress = true
allowSkip = false

[List]
description = "Vertical list of items with a label and optional detail"

[List.defaults]
selectable = false

[Card]
description = "Bordered card with title, subtitle, and content slot"

[Card.defaults]
title = "Card"
subtitle = ""

[Badge]
description = "Small inline status badge"

[Badge.defaults]
label = "badge"
color = "blue"

[Button]
description = "Clickable button with variant styles"

[Button.defaults]
label = "Button"
variant = "primary"

[Alert]
description = "Banner alert with a severity level"

[Alert.defaults]
message = "Alert"
kind = "info"

[Tabs]
description = "Horizontal tab list with active index"

[Tabs.defaults]
active = 0

[EmptyState]
description = "Centered placeholder for empty lists or pages"

[EmptyState.defaults]
message = "Nothing here"
action = ""

[Avatar]
description = "Rounded image or text avatar"

[Avatar.defaults]
label = ""
src = ""
size = "md"
+++

--- Grid
div grid grid-cols-{columns} gap-{gap} w-full
  slot

--- Panel
$: default expanded = {defaultExpanded}
div border border-zinc-700 rounded-lg overflow-hidden bg-zinc-900 mb-4
  div flex items-center justify-between p-4 bg-zinc-800 cursor-pointer
    div font-semibold text-white
      "{title}"
    if {collapsible}
      if {expanded}
        div text-zinc-400
          "▼"
      else
        div text-zinc-400
          "▶"
  if {expanded}
    div p-4
      slot

--- Wizard
$: default step = {currentStep}
div flex flex-col gap-4 w-full
  if {showProgress}
    div flex gap-2
      for s in {steps}
        div flex-1 h-1 rounded-full
          if {s.index < step}
            div h-full w-full bg-green-500 rounded-full
          else if {s.index == step}
            div h-full w-full bg-blue-500 rounded-full
          else
            div h-full w-full bg-zinc-700 rounded-full
  div flex-1
    slot
  div flex justify-between items-center pt-4
    if {step > 0}
      button px-4 py-2 rounded bg-zinc-700 text-white
        "Previous"
    else
      div
    if {step < steps.length - 1}
      button px-4 py-2 rounded bg-blue-600 text-white
        "Next"
    else
      button px-4 py-2 rounded bg-green-600 text-white
        "Complete"

--- List
div flex flex-col w-full border border-zinc-700 rounded-lg overflow-hidden bg-zinc-900
  for item in {items}
    div flex items-center justify-between p-3 border-b border-zinc-800 hover:bg-zinc-800
      div text-sm text-white
        "{item.label}"
      if {item.detail}
        div text-sm text-zinc-400
          "{item.detail}"

--- Card
div rounded-lg border border-zinc-700 bg-zinc-900 p-4 mb-4 flex flex-col gap-2
  div flex flex-row items-center justify-between
    div font-bold text-lg text-white
      "{title}"
    if {subtitle}
      div text-sm text-zinc-400
        "{subtitle}"
  slot

--- Badge
$: default color = {color}
div inline-flex items-center px-2 py-0 rounded-full text-xs font-semibold
  if {color == "green"}
    div bg-green-600 text-white px-2 py-1 rounded-full
      "{label}"
  else if {color == "red"}
    div bg-red-600 text-white px-2 py-1 rounded-full
      "{label}"
  else if {color == "yellow"}
    div bg-yellow-500 text-black px-2 py-1 rounded-full
      "{label}"
  else
    div bg-blue-600 text-white px-2 py-1 rounded-full
      "{label}"

--- Button
$: default variant = {variant}
button cursor-pointer px-4 py-2 rounded font-medium
  if {variant == "primary"}
    div bg-blue-600 text-white px-4 py-2 rounded
      "{label}"
  else if {variant == "danger"}
    div bg-red-600 text-white px-4 py-2 rounded
      "{label}"
  else if {variant == "ghost"}
    div bg-transparent text-zinc-300 border border-zinc-600 px-4 py-2 rounded
      "{label}"
  else
    div bg-zinc-700 text-white px-4 py-2 rounded
      "{label}"

--- Alert
$: default kind = {kind}
div rounded-md border px-4 py-3 flex flex-row items-start gap-3
  if {kind == "error"}
    div border-red-700 bg-red-950 text-red-300 rounded px-3 py-1 text-sm
      "{message}"
  else if {kind == "warning"}
    div border-yellow-700 bg-yellow-950 text-yellow-300 rounded px-3 py-1 text-sm
      "{message}"
  else if {kind == "success"}
    div border-green-700 bg-green-950 text-green-300 rounded px-3 py-1 text-sm
      "{message}"
  else
    div border-blue-700 bg-blue-950 text-blue-300 rounded px-3 py-1 text-sm
      "{message}"

--- Tabs
div flex flex-row gap-2 border-b border-zinc-700 mb-4
  for tab in {tabs}
    if {tab.index == active}
      div px-4 py-2 text-sm font-semibold text-white border-b-2 border-blue-500
        "{tab.label}"
    else
      div px-4 py-2 text-sm text-zinc-400 cursor-pointer
        "{tab.label}"

--- EmptyState
div flex flex-col items-center justify-center gap-3 p-8 text-center
  div text-zinc-500 text-sm
    "{message}"
  if {action}
    button px-4 py-2 rounded bg-blue-600 text-white text-sm
      "{action}"

--- Avatar
div rounded-full overflow-hidden bg-zinc-700 flex items-center justify-center text-white font-semibold
  if {size == "sm"}
    div w-8 h-8 text-xs
      if {src}
        img src={src} w-full h-full object-cover
      else if {label}
        "{label}"
      else
        "?"
  else if {size == "lg"}
    div w-16 h-16 text-xl
      if {src}
        img src={src} w-full h-full object-cover
      else if {label}
        "{label}"
      else
        "?"
  else
    div w-12 h-12 text-sm
      if {src}
        img src={src} w-full h-full object-cover
      else if {label}
        "{label}"
      else
        "?"
