# System health report — for use with `crepus render`.
# Run with:
#   crepus render examples/render/report.crepus --ctx examples/render/context.toml

div w-full bg-zinc-950 text-white flex flex-col gap-6 p-8 min-h-screen

  # Header
  div flex items-start justify-between border-b border-zinc-800 pb-4
    div flex flex-col gap-1
      div text-3xl font-bold text-white tracking-tight
        "{title}"
      div text-sm text-zinc-500
        "Generated {generated} · v{version}"
    match {health}
      "ok" =>
        div bg-emerald-900 border border-emerald-700 text-emerald-300 font-semibold text-sm px-3 py-1 rounded-full
          "HEALTHY"
      "warning" =>
        div bg-amber-900 border border-amber-700 text-amber-300 font-semibold text-sm px-3 py-1 rounded-full
          "WARNING"
      "error" =>
        div bg-red-900 border border-red-700 text-red-300 font-semibold text-sm px-3 py-1 rounded-full
          "CRITICAL"
      _ =>
        div bg-zinc-800 border border-zinc-700 text-zinc-400 font-semibold text-sm px-3 py-1 rounded-full
          "UNKNOWN"

  # Summary metrics
  div flex flex-row gap-4
    div flex flex-col gap-1 bg-zinc-900 border border-zinc-800 rounded-lg p-4 flex-1
      div text-zinc-500 text-xs uppercase tracking-wider font-medium
        "Total checks"
      div text-3xl font-bold text-white
        "{total_items}"
    div flex flex-col gap-1 bg-emerald-950 border border-emerald-900 rounded-lg p-4 flex-1
      div text-zinc-500 text-xs uppercase tracking-wider font-medium
        "OK"
      div text-3xl font-bold text-emerald-400
        "{ok_count}"
    div flex flex-col gap-1 bg-amber-950 border border-amber-900 rounded-lg p-4 flex-1
      div text-zinc-500 text-xs uppercase tracking-wider font-medium
        "Warnings"
      div text-3xl font-bold text-amber-400
        "{warn_count}"
    div flex flex-col gap-1 bg-red-950 border border-red-900 rounded-lg p-4 flex-1
      div text-zinc-500 text-xs uppercase tracking-wider font-medium
        "Errors"
      div text-3xl font-bold text-red-400
        "{error_count}"

  # Health summary message
  div rounded-lg border px-4 py-3
    if {health == "ok"}
      div border-emerald-800 bg-emerald-950 text-emerald-300 text-sm rounded px-3 py-2
        "All systems operational. No action required."
    else if {health == "warning"}
      div border-amber-800 bg-amber-950 text-amber-300 text-sm rounded px-3 py-2
        "Some checks require attention. Review warnings below."
    else if {health == "error"}
      div border-red-800 bg-red-950 text-red-300 text-sm rounded px-3 py-2
        "Critical errors detected. Immediate action required."
    else
      div border-zinc-700 bg-zinc-900 text-zinc-400 text-sm rounded px-3 py-2
        "Status could not be determined."

  # Usage note
  div flex flex-col gap-2 border border-zinc-800 rounded-lg p-4 bg-zinc-900
    div text-sm font-semibold text-zinc-400
      "Passing item data"
    div text-sm text-zinc-500
      "Item lists can be passed at render time using --var flags or a full TOML context file."
    div text-xs text-zinc-600 font-mono bg-zinc-950 rounded px-3 py-2 mt-1
      "crepus render report.crepus --ctx context.toml --var health=error"

  # Footer
  div border-t border-zinc-800 pt-4 flex justify-between items-center
    div text-xs text-zinc-600
      "Crepuscularity · {title}"
    div text-xs text-zinc-600
      "v{version}"
