# Demo template — shows all supported DSL features.
# Run with: crepu-dev examples/demo.crepus
# Or with vars: crepu-dev examples/demo.crepus --var title="Hello" --bool show_badge=true --int score=42
# Or with context file: crepus render examples/demo.crepus --ctx examples/demo-context.json

div w-full h-full bg-zinc-950 text-white flex flex-col gap-4 p-8

    # ── Header ──────────────────────────────────────────
    div flex items-center gap-3

        div text-3xl font-bold text-white
            "{title}"

        # Conditional badge using if/else
        if {show_badge}
            div bg-emerald-500 text-white text-xs font-bold px-2 py-1 rounded-full
                "LIVE"
        else
            div bg-zinc-700 text-zinc-400 text-xs font-bold px-2 py-1 rounded-full
                "OFFLINE"

    # ── Score section with else-if ────────────────────────
    div flex flex-col gap-2

        div text-sm font-medium text-zinc-400
            "Score level:"

        $: let score_label = {score}

        if {score} > 80
            div text-2xl font-bold text-emerald-400
                "Excellent — {score_label}/100"
        else if {score} > 50
            div text-2xl font-bold text-amber-400
                "Good — {score_label}/100"
        else if {score} > 20
            div text-2xl font-bold text-orange-400
                "Fair — {score_label}/100"
        else
            div text-2xl font-bold text-red-400
                "Needs work — {score_label}/100"

    # ── Match expression ─────────────────────────────────
    div flex flex-col gap-2

        div text-sm font-medium text-zinc-400
            "Status:"

        match {status}
        "active" =>
            div flex items-center gap-2
                div w-2 h-2 rounded-full bg-emerald-500
                div text-emerald-300 font-semibold
                    "Active"
        "paused" =>
            div flex items-center gap-2
                div w-2 h-2 rounded-full bg-amber-400
                div text-amber-300 font-semibold
                    "Paused"
        "error" =>
            div flex items-center gap-2
                div w-2 h-2 rounded-full bg-red-500
                div text-red-300 font-semibold
                    "Error"
        _ =>
            div text-zinc-500 italic
                "Unknown"

    # ── For loop ──────────────────────────────────────────
    div flex flex-col gap-1

        div text-sm font-medium text-zinc-400
            "Items:"

        for item in {items}
            div flex items-center gap-2 py-1 border-b border-zinc-800
                div w-1 h-1 rounded-full bg-sky-400
                div text-zinc-200
                    "{item}"

    # ── Color palette showcase ─────────────────────────
    div flex flex-wrap gap-2 mt-2

        div w-8 h-8 rounded bg-slate-500
        div w-8 h-8 rounded bg-blue-500
        div w-8 h-8 rounded bg-indigo-500
        div w-8 h-8 rounded bg-violet-500
        div w-8 h-8 rounded bg-purple-500
        div w-8 h-8 rounded bg-pink-500
        div w-8 h-8 rounded bg-rose-500
        div w-8 h-8 rounded bg-red-500
        div w-8 h-8 rounded bg-orange-500
        div w-8 h-8 rounded bg-amber-500
        div w-8 h-8 rounded bg-yellow-500
        div w-8 h-8 rounded bg-lime-500
        div w-8 h-8 rounded bg-green-500
        div w-8 h-8 rounded bg-teal-500
        div w-8 h-8 rounded bg-cyan-500
        div w-8 h-8 rounded bg-sky-500
        div w-8 h-8 rounded bg-[#ff6b35]