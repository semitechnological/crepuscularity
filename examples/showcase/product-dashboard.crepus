div min-h-screen bg-[#0b1020] text-white flex flex-col gap-6 p-8
  div flex items-center justify-between
    div flex flex-col gap-1
      div text-xs uppercase tracking-widest text-sky-300
        "Northstar operations"
      div text-3xl font-bold
        "Launch readiness"
      div text-sm text-slate-400
        "A compact dashboard built from one Crepus template"
    div flex items-center gap-3
      if {live}
        div bg-emerald-500 text-emerald-950 text-xs font-bold px-3 py-1 rounded-full
          "LIVE"
      else
        div bg-slate-700 text-slate-300 text-xs font-bold px-3 py-1 rounded-full
          "PAUSED"
      button @click="refresh" bg-white text-slate-950 font-semibold px-4 py-2 rounded-lg
        "Refresh"
  div grid grid-cols-4 gap-4
    for metric in {metrics}
      div bg-[#151d35] border border-slate-700 rounded-2xl p-5 flex flex-col gap-3
        div flex items-center justify-between
          div text-sm text-slate-400
            "{label}"
          div w-2 h-2 rounded-full bg-sky-400
        div text-3xl font-bold
          "{value}"
        div text-xs text-emerald-300
          "{delta}"
  div grid grid-cols-3 gap-6
    div col-span-2 bg-[#151d35] border border-slate-700 rounded-2xl p-6 flex flex-col gap-5
      div flex items-center justify-between
        div
          div text-lg font-semibold
            "Team activity"
          div text-sm text-slate-400
            "What changed across the workspace"
        div text-xs text-slate-500
          "Updated just now"
      div flex flex-col gap-3
        for activity in {activities}
          div flex items-center gap-3 border-b border-slate-800 pb-3
            if {state == "done"}
              div w-9 h-9 rounded-full bg-emerald-500 text-emerald-950 flex items-center justify-center font-bold
                "✓"
            else
              div w-9 h-9 rounded-full bg-amber-400 text-amber-950 flex items-center justify-center font-bold
                "…"
            div flex flex-col gap-1
              div text-sm font-medium
                "{title}"
              div text-xs text-slate-400
                "{meta}"
    div bg-[#151d35] border border-slate-700 rounded-2xl p-6 flex flex-col gap-5
      div
        div text-lg font-semibold
          "Release health"
        div text-sm text-slate-400
          "Current production signal"
      match {health}
      "good" =>
        div flex flex-col gap-2
          div text-4xl font-bold text-emerald-300
            "98%"
          div text-sm text-emerald-200
            "Everything is on track"
      "watch" =>
        div flex flex-col gap-2
          div text-4xl font-bold text-amber-300
            "76%"
          div text-sm text-amber-200
            "A few checks need attention"
      _ =>
        div flex flex-col gap-2
          div text-4xl font-bold text-rose-300
            "42%"
          div text-sm text-rose-200
            "Pause the rollout"
      div h-2 rounded-full bg-slate-700 overflow-hidden
        div h-full w-4/5 rounded-full bg-emerald-400
  div bg-gradient-to-r from-sky-500 to-indigo-600 rounded-2xl p-6 flex items-center justify-between
    div flex flex-col gap-1
      div text-xl font-bold
        "Ready for the next deployment?"
      div text-sm text-sky-100
        "The same template can render through web, desktop, native, and embedded targets."
    button @click="deploy" bg-white text-indigo-950 font-semibold px-5 py-3 rounded-lg
      "Deploy now"
