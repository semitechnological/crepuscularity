<div class="w-full h-full bg-zinc-950 text-white flex flex-col gap-6 p-8">

  <div class="text-2xl font-bold">
    JSX Syntax Demo
  </div>
  <div class="text-sm text-zinc-500 -mt-4">
    The same DSL features, using angle-bracket HTML/JSX style
  </div>

  <div class="flex flex-col gap-2">
    <div class="text-xs font-semibold uppercase tracking-widest text-zinc-500">
      CONDITIONAL (if / else)
    </div>
    <if condition={show_header}>
      <div class="flex items-center gap-2 bg-emerald-900 border border-emerald-700 rounded-lg px-3 py-2 text-emerald-300 text-sm">
        Hello, {name}! The header is visible.
      </div>
      <else>
        <div class="text-zinc-500 text-sm italic">Header hidden.</div>
      </else>
    </if>
  </div>

  <div class="flex flex-col gap-2">
    <div class="text-xs font-semibold uppercase tracking-widest text-zinc-500">
      ELSE-IF CHAIN
    </div>
    <if condition={score > 80}>
      <div class="text-2xl font-bold text-emerald-400">Excellent — {score}/100</div>
    </if>
    <if condition={score <= 80}>
      <if condition={score > 50}>
        <div class="text-2xl font-bold text-amber-400">Good — {score}/100</div>
      </if>
      <if condition={score <= 50}>
        <div class="text-2xl font-bold text-red-400">Needs work — {score}/100</div>
      </if>
    </if>
  </div>

  <div class="flex flex-col gap-2">
    <div class="text-xs font-semibold uppercase tracking-widest text-zinc-500">
      MATCH
    </div>
    <match on={status}>
      <case pattern="active">
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
          <div class="text-emerald-300 font-semibold">Active</div>
        </div>
      </case>
      <case pattern="paused">
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 rounded-full bg-amber-400"></div>
          <div class="text-amber-300 font-semibold">Paused</div>
        </div>
      </case>
      <case pattern="error">
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 rounded-full bg-red-500"></div>
          <div class="text-red-300 font-semibold">Error</div>
        </div>
      </case>
      <case pattern="_">
        <div class="text-zinc-500 italic">Unknown status</div>
      </case>
    </match>
  </div>

  <div class="flex flex-col gap-2">
    <div class="text-xs font-semibold uppercase tracking-widest text-zinc-500">
      FOR LOOP (pass data via --var or context)
    </div>
    <div class="flex flex-col gap-1">
      <for let="item" in={items}>
        <div class="flex items-center gap-2 py-1 border-b border-zinc-800 text-sm">
          <div class="w-1 h-1 rounded-full bg-sky-400 flex-shrink-0"></div>
          <div class="text-zinc-300">{item}</div>
        </div>
      </for>
      <if condition={name}>
        <div class="text-zinc-600 text-xs italic">
          (add items via crepus preview --var items=[...])
        </div>
      </if>
    </div>
  </div>

  <div class="flex flex-col gap-2">
    <div class="text-xs font-semibold uppercase tracking-widest text-zinc-500">
      INCLUDE (component)
    </div>
    <include src="components/card.crepus" title="JSX Card" subtitle="Included via JSX syntax" />
  </div>

  <div class="flex flex-col gap-2">
    <div class="text-xs font-semibold uppercase tracking-widest text-zinc-500">
      LET DECLARATION
    </div>
    <div class="text-sm text-zinc-300">
      Score: {score} · Status: {status} · Name: {name}
    </div>
  </div>

</div>
