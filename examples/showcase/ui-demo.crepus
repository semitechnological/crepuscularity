div w-full h-full bg-zinc-950 text-white p-8 flex flex-col gap-6

  div text-2xl font-bold mb-2
    "Multi-Component Demo"
  div text-sm text-zinc-400 mb-6
    "All components loaded from a single ui.crepus file"

  # Cards
  div flex flex-col gap-3
    div text-lg font-semibold text-zinc-300 mb-1
      "Cards"
    include ui.crepus#Card title="Default card"
    include ui.crepus#Card title="Card with subtitle" subtitle="Some extra context here"
      div text-sm text-zinc-300 p-2
        "This is slot content rendered inside the card."
    include ui.crepus#Card
      div text-zinc-400 text-sm
        "No title — fallback to TOML default"

  # Badges
  div flex flex-row gap-2 items-center
    div text-lg font-semibold text-zinc-300 mr-2
      "Badges"
    include ui.crepus#Badge label="info"
    include ui.crepus#Badge label="active"
    include ui.crepus#Badge label="paused"

  # Buttons
  div flex flex-row gap-3 items-center
    div text-lg font-semibold text-zinc-300 mr-2
      "Buttons"
    include ui.crepus#Button label="Primary" variant="primary"
    include ui.crepus#Button label="Danger" variant="danger"
    include ui.crepus#Button label="Ghost" variant="ghost"
    include ui.crepus#Button label="Default"

  # Alerts
  div flex flex-col gap-2
    div text-lg font-semibold text-zinc-300 mb-1
      "Alerts"
    include ui.crepus#Alert message="Everything looks good" kind="success"
    include ui.crepus#Alert message="Deployment is pending" kind="warning"
    include ui.crepus#Alert message="Connection failed" kind="error"
    include ui.crepus#Alert message="New version available" kind="info"
