div min-h-screen bg-slate-950 text-white flex flex-col gap-6 p-8
  div flex flex-col gap-1
    div text-xs uppercase tracking-widest text-cyan-300
      "Control gallery"
    div text-3xl font-bold
      "Build interfaces from primitives"
    div text-sm text-slate-400
      "Inputs, selection, progress, actions, and media affordances in one screen"
  div grid grid-cols-2 gap-5
    div bg-slate-900 border border-slate-800 rounded-2xl p-5 flex flex-col gap-4
      div text-lg font-semibold
        "Form controls"
      input bind=search placeholder="Search the workspace" class="w-full bg-slate-800 rounded-lg px-3 py-2"
      picker bind=mode class="w-full bg-slate-800 rounded-lg px-3 py-2"
        span value="all"
          "All projects"
        span value="active"
          "Active only"
        span value="archived"
          "Archived"
      toggle bind=notifications checked=true
        "Notify me about changes"
      checkbox bind=remember checked=false
        "Remember this filter"
      slider bind=zoom value=70 min=0 max=100 step=10 label="Preview zoom"
    div bg-slate-900 border border-slate-800 rounded-2xl p-5 flex flex-col gap-4
      div text-lg font-semibold
        "Status and progress"
      div flex items-center gap-3
        badge tone="success"
          "Online"
        badge tone="warning"
          "Syncing"
        badge tone="error"
          "Blocked"
      progress value=72 max=100 label="Workspace sync"
      meter value=640 min=0 max=1000 label="Storage"
      div flex gap-3
        button @click="save" bg-cyan-400 text-slate-950 font-semibold px-4 py-2 rounded-lg
          "Save changes"
        button @click="cancel" border border-slate-600 text-slate-300 px-4 py-2 rounded-lg
          "Cancel"
      divider
      div flex items-center gap-3
        spacer size=16
        div text-sm text-slate-400
          "Use the same tree for every backend"
  div grid grid-cols-2 gap-5
    div bg-slate-900 border border-slate-800 rounded-2xl p-5 flex flex-col gap-3
      div text-lg font-semibold
        "Dropzone"
      dropzone @drop="import_files" accept="image/*,application/pdf" border border-dashed border-slate-600 rounded-xl p-8 flex items-center justify-center
        div text-sm text-slate-400
          "Drop files here"
      file-picker accept="image/*,video/*" multiple @pick="pick_media" bg-slate-800 px-4 py-2 rounded-lg w-fit
        "Choose media"
    div bg-slate-900 border border-slate-800 rounded-2xl p-5 flex flex-col gap-3
      div text-lg font-semibold
        "Scrollable tags"
      scroll axis="row" class="flex gap-2 overflow-x-auto"
        badge tone="success"
          "LAN"
        badge tone="success"
          "Synced"
        badge tone="warning"
          "Review"
        badge tone="success"
          "Encrypted"
      img object-cover object-center src="https://example.com/acme.png" alt="Project preview" placeholder="Loading preview" class="rounded-xl h-32 w-full bg-slate-800"
