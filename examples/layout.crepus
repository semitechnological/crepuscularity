# Layout showcase — flex, alignment, aspect ratios, rings, spacing.
# Run with: crepus preview examples/layout.crepus

div w-full h-full bg-zinc-950 text-white flex flex-col gap-8 p-10

  div text-2xl font-bold text-white
    "Layout"
  div text-sm text-zinc-500 -mt-6
    "Flex, alignment, aspect ratios, rings, borders, and spacing"

  # ── Flex Direction ────────────────────────────────────────────────
  div flex flex-col gap-3
    div text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-1
      "FLEX DIRECTION"
    div flex flex-row gap-6
      div flex flex-col gap-2
        div text-zinc-500 text-xs mb-1
          "flex-row"
        div flex flex-row gap-2
          div w-10 h-10 rounded bg-blue-600 flex items-center justify-center text-xs
            "A"
          div w-10 h-10 rounded bg-blue-600 flex items-center justify-center text-xs
            "B"
          div w-10 h-10 rounded bg-blue-600 flex items-center justify-center text-xs
            "C"
      div flex flex-col gap-2
        div text-zinc-500 text-xs mb-1
          "flex-col"
        div flex flex-col gap-2
          div w-10 h-10 rounded bg-violet-600 flex items-center justify-center text-xs
            "A"
          div w-10 h-10 rounded bg-violet-600 flex items-center justify-center text-xs
            "B"
          div w-10 h-10 rounded bg-violet-600 flex items-center justify-center text-xs
            "C"

  # ── Alignment ─────────────────────────────────────────────────────
  div flex flex-col gap-3
    div text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-1
      "ALIGNMENT"
    div flex flex-row gap-4
      div flex flex-col gap-1
        div text-zinc-500 text-xs mb-1
          "items-start"
        div flex flex-row items-start gap-1 h-16 bg-zinc-900 rounded p-2
          div w-6 h-4 rounded bg-emerald-600
          div w-6 h-8 rounded bg-emerald-600
          div w-6 h-6 rounded bg-emerald-600
      div flex flex-col gap-1
        div text-zinc-500 text-xs mb-1
          "items-center"
        div flex flex-row items-center gap-1 h-16 bg-zinc-900 rounded p-2
          div w-6 h-4 rounded bg-sky-600
          div w-6 h-8 rounded bg-sky-600
          div w-6 h-6 rounded bg-sky-600
      div flex flex-col gap-1
        div text-zinc-500 text-xs mb-1
          "items-end"
        div flex flex-row items-end gap-1 h-16 bg-zinc-900 rounded p-2
          div w-6 h-4 rounded bg-rose-600
          div w-6 h-8 rounded bg-rose-600
          div w-6 h-6 rounded bg-rose-600
      div flex flex-col gap-1
        div text-zinc-500 text-xs mb-1
          "justify-between"
        div flex flex-row justify-between w-48 bg-zinc-900 rounded p-2
          div w-8 h-8 rounded bg-amber-600
          div w-8 h-8 rounded bg-amber-600
          div w-8 h-8 rounded bg-amber-600

  # ── Self-Alignment (NEW) ──────────────────────────────────────────
  div flex flex-col gap-3
    div text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-1
      "SELF-ALIGNMENT (self-*)"
    div flex flex-row gap-6
      div flex flex-col items-center gap-1
        div text-zinc-500 text-xs mb-1
          "self-start"
        div flex flex-col h-24 w-20 bg-zinc-900 rounded p-2
          div self-start w-12 h-6 rounded bg-indigo-500 flex items-center justify-center text-xs
            "start"
      div flex flex-col items-center gap-1
        div text-zinc-500 text-xs mb-1
          "self-center"
        div flex flex-col h-24 w-20 bg-zinc-900 rounded p-2
          div self-center w-12 h-6 rounded bg-sky-500 flex items-center justify-center text-xs
            "center"
      div flex flex-col items-center gap-1
        div text-zinc-500 text-xs mb-1
          "self-end"
        div flex flex-col h-24 w-20 bg-zinc-900 rounded p-2
          div self-end w-12 h-6 rounded bg-emerald-500 flex items-center justify-center text-xs
            "end"
      div flex flex-col items-center gap-1
        div text-zinc-500 text-xs mb-1
          "self-stretch"
        div flex flex-col h-24 w-20 bg-zinc-900 rounded p-2
          div self-stretch h-6 rounded bg-rose-500 flex items-center justify-center text-xs
            "stretch"

  # ── Aspect Ratio (NEW) ────────────────────────────────────────────
  div flex flex-col gap-3
    div text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-1
      "ASPECT RATIO"
    div flex flex-row gap-6 items-end
      div flex flex-col items-center gap-2
        div text-zinc-500 text-xs
          "aspect-square"
        div aspect-square w-24 bg-blue-600 rounded flex items-center justify-center text-sm
          "1:1"
      div flex flex-col items-center gap-2
        div text-zinc-500 text-xs
          "aspect-video"
        div aspect-video w-32 bg-violet-600 rounded flex items-center justify-center text-sm
          "16:9"

  # ── Rings (NEW) ────────────────────────────────────────────────────
  div flex flex-col gap-3
    div text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-1
      "RINGS (ring-*)"
    div flex flex-row gap-6
      div flex flex-col items-center gap-2
        div text-zinc-500 text-xs
          "ring-1"
        div ring-1 w-16 h-16 rounded bg-zinc-900 flex items-center justify-center text-xs text-zinc-400
          "ring-1"
      div flex flex-col items-center gap-2
        div text-zinc-500 text-xs
          "ring-2"
        div ring-2 w-16 h-16 rounded bg-zinc-900 flex items-center justify-center text-xs text-zinc-400
          "ring-2"
      div flex flex-col items-center gap-2
        div text-zinc-500 text-xs
          "ring-4"
        div ring-4 w-16 h-16 rounded bg-zinc-900 flex items-center justify-center text-xs text-zinc-400
          "ring-4"
      div flex flex-col items-center gap-2
        div text-zinc-500 text-xs
          "ring-8"
        div ring-8 w-16 h-16 rounded bg-zinc-900 flex items-center justify-center text-xs text-zinc-400
          "ring-8"

  # ── Borders & Rounding ────────────────────────────────────────────
  div flex flex-col gap-3
    div text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-1
      "BORDERS & ROUNDING"
    div flex flex-row gap-4
      div flex flex-col items-center gap-2
        div text-zinc-500 text-xs
          "rounded-none"
        div rounded-none border border-zinc-600 w-12 h-12 bg-zinc-900
      div flex flex-col items-center gap-2
        div text-zinc-500 text-xs
          "rounded"
        div rounded border border-zinc-600 w-12 h-12 bg-zinc-900
      div flex flex-col items-center gap-2
        div text-zinc-500 text-xs
          "rounded-lg"
        div rounded-lg border border-zinc-600 w-12 h-12 bg-zinc-900
      div flex flex-col items-center gap-2
        div text-zinc-500 text-xs
          "rounded-xl"
        div rounded-xl border border-zinc-600 w-12 h-12 bg-zinc-900
      div flex flex-col items-center gap-2
        div text-zinc-500 text-xs
          "rounded-full"
        div rounded-full border border-zinc-600 w-12 h-12 bg-zinc-900
      div flex flex-col items-center gap-2
        div text-zinc-500 text-xs
          "border-2"
        div rounded-lg border-2 border-blue-500 w-12 h-12 bg-zinc-900
      div flex flex-col items-center gap-2
        div text-zinc-500 text-xs
          "border-4"
        div rounded-lg border-4 border-rose-500 w-12 h-12 bg-zinc-900

  # ── Spacing ───────────────────────────────────────────────────────
  div flex flex-col gap-3
    div text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-1
      "GAP SPACING"
    div flex flex-col gap-3
      div flex flex-col gap-1
        div text-zinc-500 text-xs
          "gap-1"
        div flex flex-row gap-1
          div w-8 h-4 rounded bg-zinc-700
          div w-8 h-4 rounded bg-zinc-700
          div w-8 h-4 rounded bg-zinc-700
          div w-8 h-4 rounded bg-zinc-700
      div flex flex-col gap-1
        div text-zinc-500 text-xs
          "gap-4"
        div flex flex-row gap-4
          div w-8 h-4 rounded bg-zinc-600
          div w-8 h-4 rounded bg-zinc-600
          div w-8 h-4 rounded bg-zinc-600
          div w-8 h-4 rounded bg-zinc-600
      div flex flex-col gap-1
        div text-zinc-500 text-xs
          "gap-8"
        div flex flex-row gap-8
          div w-8 h-4 rounded bg-zinc-500
          div w-8 h-4 rounded bg-zinc-500
          div w-8 h-4 rounded bg-zinc-500
          div w-8 h-4 rounded bg-zinc-500
