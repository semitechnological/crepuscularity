div #panel w-full h-full flex flex-col gap-3 bg-[#101820] p-4
  h1 text-white text-lg
    "{device} {panel}"
  div flex flex-row gap-2
    span text-zinc-100
      "CPU"
    progress #cpu value={cpu}
  div flex flex-row gap-2
    span text-zinc-100
      "Status"
    span text-green-500
      "{status}"
  button #ack bg-blue-500 text-white rounded @click="acknowledge"
    "Acknowledge"
