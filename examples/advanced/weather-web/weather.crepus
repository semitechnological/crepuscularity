div class="min-h-screen bg-zinc-950 flex items-center justify-center p-4"
  div class="bg-zinc-900 text-white rounded-2xl p-8 max-w-sm w-full shadow-xl border border-zinc-800"
    div class="flex items-start justify-between mb-2"
      div
        h1 class="text-2xl font-bold"
          "{city}"
        p class="text-zinc-400 text-sm"
          "{country}"
    p class="text-7xl font-light my-6"
      "{temp}°C"
    p class="text-zinc-300 text-lg mb-6"
      "{description}"
    div class="grid grid-cols-3 gap-4 text-center border-t border-zinc-800 pt-4"
      div
        p class="text-zinc-400 text-xs uppercase tracking-wide"
          "Feels like"
        p class="text-white font-semibold"
          "{feels_like}°"
      div
        p class="text-zinc-400 text-xs uppercase tracking-wide"
          "Humidity"
        p class="text-white font-semibold"
          "{humidity}%"
      div
        p class="text-zinc-400 text-xs uppercase tracking-wide"
          "Wind"
        p class="text-white font-semibold"
          "{wind_kmh} km/h"
