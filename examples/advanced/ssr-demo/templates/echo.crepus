div class="min-h-screen bg-zinc-950 text-white p-8 max-w-lg mx-auto"
  h1 class="text-3xl font-bold mb-6"
    "SSR Echo"
  form method="POST" action="/echo" class="flex flex-col gap-4"
    input type="text" name="message" value="{message}" placeholder="Type something..." class="bg-zinc-800 text-white rounded px-4 py-2 border border-zinc-700 focus:outline-none focus:border-blue-500"
    button type="submit" class="bg-blue-600 text-white rounded px-4 py-2 hover:bg-blue-700 transition-colors"
      "Submit"
  if {has_echo}
    div class="mt-6 p-4 bg-zinc-800 rounded-lg border border-zinc-700"
      p class="text-zinc-400 text-sm mb-1"
        "Server received:"
      p class="text-white text-xl font-mono"
        "{message}"
  a href="/" class="mt-6 block text-blue-400 hover:underline"
    "← Home"
