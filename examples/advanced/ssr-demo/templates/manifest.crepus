div class="min-h-screen bg-zinc-950 text-white p-8"
  h1 class="text-3xl font-bold mb-2"
    "Hydration Manifest"
  p class="text-zinc-400 mb-6"
    "JSON manifest emitted by the SSR engine for the home template:"
  pre class="bg-zinc-900 border border-zinc-700 rounded-xl p-6 text-sm text-green-400 overflow-auto whitespace-pre-wrap"
    "{manifest}"
  a href="/" class="mt-6 block text-blue-400 hover:underline"
    "← Home"
