{
  "version": 6,
  "root": [
    {
      "kind": "stack",
      "axis": "column",
      "style": {
        "width": -1.0,
        "height": -1.0,
        "fontFamily": "sans",
        "foregroundColor": "#fafafa",
        "backgroundColor": "#0a0a0a",
        "flexDirection": "column"
      },
      "children": [
        {
          "kind": "stack",
          "axis": "column",
          "style": {
            "width": -1.0,
            "flexGrow": 1.0,
            "flexShrink": 1.0,
            "flexDirection": "column"
          },
          "children": [
            {
              "kind": "tabs",
              "bind": "current_tab",
              "tabs": [
                {
                  "value": "tasks",
                  "label": "Tasks",
                  "icon": "checklist",
                  "children": [
                    {
                      "kind": "scroll",
                      "axis": "column",
                      "style": {
                        "paddingHorizontal": 20.0,
                        "paddingVertical": 16.0,
                        "width": -1.0,
                        "flexGrow": 1.0,
                        "flexShrink": 1.0,
                        "flexDirection": "column"
                      },
                      "children": [
                        {
                          "kind": "stack",
                          "axis": "column",
                          "spacing": 12.0,
                          "children": [
                            {
                              "kind": "stack",
                              "axis": "row",
                              "alignItems": "center",
                              "justifyContent": "between",
                              "children": [
                                {
                                  "kind": "stack",
                                  "axis": "column",
                                  "style": {
                                    "fontSize": 20.0,
                                    "fontWeight": 600
                                  },
                                  "children": [
                                    {
                                      "kind": "text",
                                      "content": "Tasks"
                                    }
                                  ]
                                },
                                {
                                  "kind": "button",
                                  "label": "Add",
                                  "onClick": "tasks.add",
                                  "style": {
                                    "paddingHorizontal": 16.0,
                                    "paddingVertical": 8.0,
                                    "fontSize": 14.0,
                                    "fontWeight": 600,
                                    "foregroundColor": "#000000",
                                    "backgroundColor": "#22c55e",
                                    "cornerRadius": 8.0
                                  }
                                }
                              ]
                            },
                            {
                              "kind": "if",
                              "condition": "tasks_count <= 0",
                              "thenChildren": [
                                {
                                  "kind": "stack",
                                  "axis": "column",
                                  "style": {
                                    "paddingVertical": 32.0,
                                    "width": -1.0,
                                    "fontSize": 14.0,
                                    "textAlign": "center",
                                    "foregroundColor": "#71717a"
                                  },
                                  "children": [
                                    {
                                      "kind": "text",
                                      "content": "No tasks yet. Tap Add to get started."
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "kind": "forEach",
                              "bind": "tasks",
                              "itemName": "task",
                              "itemBody": [
                                {
                                  "kind": "stack",
                                  "axis": "row",
                                  "spacing": 12.0,
                                  "alignItems": "center",
                                  "style": {
                                    "paddingHorizontal": 16.0,
                                    "paddingVertical": 12.0,
                                    "width": -1.0,
                                    "backgroundColor": "#18181b",
                                    "cornerRadius": 8.0
                                  },
                                  "children": [
                                    {
                                      "kind": "toggle",
                                      "label": "",
                                      "bind": "task.done",
                                      "checked": false,
                                      "onChange": "tasks.toggle"
                                    },
                                    {
                                      "kind": "stack",
                                      "axis": "column",
                                      "spacing": 4.0,
                                      "style": {
                                        "flexGrow": 1.0,
                                        "flexShrink": 1.0,
                                        "flexDirection": "column"
                                      },
                                      "children": [
                                        {
                                          "kind": "text",
                                          "content": "",
                                          "bind": "task.title",
                                          "style": {
                                            "fontSize": 16.0
                                          }
                                        },
                                        {
                                          "kind": "if",
                                          "condition": "task.due != \"\"",
                                          "thenChildren": [
                                            {
                                              "kind": "text",
                                              "content": "",
                                              "bind": "task.due",
                                              "style": {
                                                "fontSize": 12.0,
                                                "foregroundColor": "#71717a"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "value": "notes",
                  "label": "Notes",
                  "icon": "doc.text",
                  "children": [
                    {
                      "kind": "scroll",
                      "axis": "column",
                      "style": {
                        "paddingHorizontal": 20.0,
                        "paddingVertical": 16.0,
                        "width": -1.0,
                        "flexGrow": 1.0,
                        "flexShrink": 1.0,
                        "flexDirection": "column"
                      },
                      "children": [
                        {
                          "kind": "stack",
                          "axis": "column",
                          "spacing": 12.0,
                          "children": [
                            {
                              "kind": "stack",
                              "axis": "row",
                              "alignItems": "center",
                              "justifyContent": "between",
                              "children": [
                                {
                                  "kind": "stack",
                                  "axis": "column",
                                  "style": {
                                    "fontSize": 20.0,
                                    "fontWeight": 600
                                  },
                                  "children": [
                                    {
                                      "kind": "text",
                                      "content": "Notes"
                                    }
                                  ]
                                },
                                {
                                  "kind": "button",
                                  "label": "New",
                                  "onClick": "notes.add",
                                  "style": {
                                    "paddingHorizontal": 16.0,
                                    "paddingVertical": 8.0,
                                    "fontSize": 14.0,
                                    "fontWeight": 600,
                                    "foregroundColor": "#ffffff",
                                    "backgroundColor": "#3b82f6",
                                    "cornerRadius": 8.0
                                  }
                                }
                              ]
                            },
                            {
                              "kind": "if",
                              "condition": "notes_count <= 0",
                              "thenChildren": [
                                {
                                  "kind": "stack",
                                  "axis": "column",
                                  "style": {
                                    "paddingVertical": 32.0,
                                    "width": -1.0,
                                    "fontSize": 14.0,
                                    "textAlign": "center",
                                    "foregroundColor": "#71717a"
                                  },
                                  "children": [
                                    {
                                      "kind": "text",
                                      "content": "No notes yet."
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "kind": "forEach",
                              "bind": "notes",
                              "itemName": "note",
                              "itemBody": [
                                {
                                  "kind": "stack",
                                  "axis": "column",
                                  "spacing": 4.0,
                                  "style": {
                                    "paddingHorizontal": 16.0,
                                    "paddingVertical": 12.0,
                                    "width": -1.0,
                                    "backgroundColor": "#18181b",
                                    "cornerRadius": 8.0,
                                    "flexDirection": "column"
                                  },
                                  "children": [
                                    {
                                      "kind": "text",
                                      "content": "",
                                      "bind": "note.title",
                                      "style": {
                                        "fontSize": 16.0,
                                        "fontWeight": 500
                                      }
                                    },
                                    {
                                      "kind": "text",
                                      "content": "",
                                      "bind": "note.preview",
                                      "style": {
                                        "fontSize": 14.0,
                                        "foregroundColor": "#a1a1aa"
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "value": "settings",
                  "label": "Settings",
                  "icon": "gear",
                  "children": [
                    {
                      "kind": "scroll",
                      "axis": "column",
                      "style": {
                        "paddingHorizontal": 20.0,
                        "paddingVertical": 16.0,
                        "width": -1.0,
                        "flexGrow": 1.0,
                        "flexShrink": 1.0,
                        "flexDirection": "column"
                      },
                      "children": [
                        {
                          "kind": "stack",
                          "axis": "column",
                          "spacing": 16.0,
                          "children": [
                            {
                              "kind": "stack",
                              "axis": "column",
                              "style": {
                                "fontSize": 20.0,
                                "fontWeight": 600
                              },
                              "children": [
                                {
                                  "kind": "text",
                                  "content": "Settings"
                                }
                              ]
                            },
                            {
                              "kind": "stack",
                              "axis": "column",
                              "spacing": 12.0,
                              "style": {
                                "width": -1.0,
                                "flexDirection": "column"
                              },
                              "children": [
                                {
                                  "kind": "stack",
                                  "axis": "row",
                                  "alignItems": "center",
                                  "justifyContent": "between",
                                  "style": {
                                    "paddingHorizontal": 16.0,
                                    "paddingVertical": 12.0,
                                    "backgroundColor": "#18181b",
                                    "cornerRadius": 8.0
                                  },
                                  "children": [
                                    {
                                      "kind": "stack",
                                      "axis": "column",
                                      "style": {
                                        "fontSize": 16.0
                                      },
                                      "children": [
                                        {
                                          "kind": "text",
                                          "content": "Dark mode"
                                        }
                                      ]
                                    },
                                    {
                                      "kind": "toggle",
                                      "label": "",
                                      "bind": "dark_mode",
                                      "checked": false,
                                      "onChange": "settings.darkMode"
                                    }
                                  ]
                                },
                                {
                                  "kind": "stack",
                                  "axis": "row",
                                  "alignItems": "center",
                                  "justifyContent": "between",
                                  "style": {
                                    "paddingHorizontal": 16.0,
                                    "paddingVertical": 12.0,
                                    "backgroundColor": "#18181b",
                                    "cornerRadius": 8.0
                                  },
                                  "children": [
                                    {
                                      "kind": "stack",
                                      "axis": "column",
                                      "style": {
                                        "fontSize": 16.0
                                      },
                                      "children": [
                                        {
                                          "kind": "text",
                                          "content": "Notifications"
                                        }
                                      ]
                                    },
                                    {
                                      "kind": "toggle",
                                      "label": "",
                                      "bind": "notifications",
                                      "checked": false,
                                      "onChange": "settings.notifications"
                                    }
                                  ]
                                },
                                {
                                  "kind": "stack",
                                  "axis": "row",
                                  "alignItems": "center",
                                  "justifyContent": "between",
                                  "style": {
                                    "paddingHorizontal": 16.0,
                                    "paddingVertical": 12.0,
                                    "backgroundColor": "#18181b",
                                    "cornerRadius": 8.0
                                  },
                                  "children": [
                                    {
                                      "kind": "stack",
                                      "axis": "column",
                                      "style": {
                                        "fontSize": 16.0
                                      },
                                      "children": [
                                        {
                                          "kind": "text",
                                          "content": "Sync"
                                        }
                                      ]
                                    },
                                    {
                                      "kind": "toggle",
                                      "label": "",
                                      "bind": "sync_enabled",
                                      "checked": false,
                                      "onChange": "settings.sync"
                                    }
                                  ]
                                },
                                {
                                  "kind": "stack",
                                  "axis": "column",
                                  "spacing": 8.0,
                                  "style": {
                                    "paddingHorizontal": 16.0,
                                    "paddingVertical": 12.0,
                                    "backgroundColor": "#18181b",
                                    "cornerRadius": 8.0,
                                    "flexDirection": "column"
                                  },
                                  "children": [
                                    {
                                      "kind": "stack",
                                      "axis": "column",
                                      "style": {
                                        "fontSize": 16.0
                                      },
                                      "children": [
                                        {
                                          "kind": "text",
                                          "content": "Font size"
                                        }
                                      ]
                                    },
                                    {
                                      "kind": "slider",
                                      "bind": "font_size",
                                      "value": 0.0,
                                      "min": 12.0,
                                      "max": 24.0,
                                      "step": 1.0,
                                      "style": {
                                        "width": -1.0
                                      }
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "kind": "stack",
                              "axis": "column",
                              "spacing": 8.0,
                              "style": {
                                "marginTop": 16.0,
                                "width": -1.0,
                                "flexDirection": "column"
                              },
                              "children": [
                                {
                                  "kind": "text",
                                  "content": "",
                                  "bind": "app_version",
                                  "style": {
                                    "fontSize": 14.0,
                                    "foregroundColor": "#71717a"
                                  }
                                },
                                {
                                  "kind": "button",
                                  "label": "Reset all data",
                                  "onClick": "settings.reset",
                                  "style": {
                                    "paddingHorizontal": 16.0,
                                    "paddingVertical": 8.0,
                                    "width": -2.0,
                                    "fontSize": 14.0,
                                    "fontWeight": 600,
                                    "foregroundColor": "#ffffff",
                                    "backgroundColor": "#ef4444",
                                    "cornerRadius": 8.0
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "style": {
                "width": -1.0,
                "height": -1.0
              }
            }
          ]
        }
      ]
    }
  ]
}
