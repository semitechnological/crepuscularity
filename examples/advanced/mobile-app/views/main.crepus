div flex flex-col w-full h-full bg-[#0a0a0a] text-[#fafafa] font-sans
  div w-full flex-1 flex flex-col
    tabs bind=current_tab w-full h-full
      tab value="tasks" label="Tasks" icon="checklist"
        div w-full flex-1 overflow-y-auto px-5 py-4 flex flex-col gap-3
          div flex items-center justify-between
            div text-xl font-semibold "Tasks"
            button @click="tasks.add" bg-[#22c55e] text-[#000000] px-4 py-2 rounded-lg text-sm font-semibold
              "Add"

          if {tasks_count <= 0}
            div w-full text-sm text-[#71717a] py-8 text-center
              "No tasks yet. Tap Add to get started."

          for task in {tasks}
            div w-full flex items-center gap-3 py-3 px-4 bg-[#18181b] rounded-lg
              toggle bind=task.done @change="tasks.toggle"
              div flex-1 flex flex-col gap-1
                div text-base bind=task.title
                if {task.due != ""}
                  div text-xs text-[#71717a] bind=task.due

      tab value="notes" label="Notes" icon="doc.text"
        div w-full flex-1 overflow-y-auto px-5 py-4 flex flex-col gap-3
          div flex items-center justify-between
            div text-xl font-semibold "Notes"
            button @click="notes.add" bg-[#3b82f6] text-[#ffffff] px-4 py-2 rounded-lg text-sm font-semibold
              "New"

          if {notes_count <= 0}
            div w-full text-sm text-[#71717a] py-8 text-center
              "No notes yet."

          for note in {notes}
            div w-full flex flex-col gap-1 py-3 px-4 bg-[#18181b] rounded-lg
              div text-base font-medium bind=note.title
              div text-sm text-[#a1a1aa] bind=note.preview

      tab value="settings" label="Settings" icon="gear"
        div w-full flex-1 overflow-y-auto px-5 py-4 flex flex-col gap-4
          div text-xl font-semibold "Settings"

          div w-full flex flex-col gap-3
            div flex items-center justify-between py-3 px-4 bg-[#18181b] rounded-lg
              div text-base "Dark mode"
              toggle bind=dark_mode @change="settings.darkMode"

            div flex items-center justify-between py-3 px-4 bg-[#18181b] rounded-lg
              div text-base "Notifications"
              toggle bind=notifications @change="settings.notifications"

            div flex items-center justify-between py-3 px-4 bg-[#18181b] rounded-lg
              div text-base "Sync"
              toggle bind=sync_enabled @change="settings.sync"

            div flex flex-col gap-2 py-3 px-4 bg-[#18181b] rounded-lg
              div text-base "Font size"
              slider bind=font_size min=12 max=24 step=1 w-full

          div w-full flex flex-col gap-2 mt-4
            div text-sm text-[#71717a] bind=app_version
            button @click="settings.reset" bg-[#ef4444] text-[#ffffff] px-4 py-2 rounded-lg text-sm font-semibold w-fit
              "Reset all data"
