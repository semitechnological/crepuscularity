# Email template — for use with `crepus render`.
# Run with:
#   crepus render examples/advanced/render/email.crepus --ctx examples/advanced/render/email-context.toml

div w-full bg-zinc-950 text-white flex flex-col items-center py-12 px-4

  # Email card
  div w-full max-w-lg flex flex-col gap-0 bg-zinc-900 rounded-2xl border border-zinc-800 overflow-hidden

    # Header stripe
    div bg-blue-600 px-8 py-6
      div text-xs font-semibold uppercase tracking-widest text-blue-200 mb-2
        "Message from {sender}"
      div text-2xl font-bold text-white leading-tight
        "{subject}"

    # Meta row
    div flex flex-row gap-6 px-8 py-3 bg-zinc-800 border-b border-zinc-700
      div flex flex-col gap-0
        div text-xs text-zinc-500 uppercase tracking-wider
          "To"
        div text-sm text-zinc-200 font-medium
          "{recipient}"
      div flex flex-col gap-0
        div text-xs text-zinc-500 uppercase tracking-wider
          "From"
        div text-sm text-zinc-200 font-medium
          "{sender}"

    # Body
    div flex flex-col gap-4 px-8 py-6
      div text-base text-zinc-200 leading-relaxed
        "{body}"

      # CTA button
      div flex justify-center mt-2
        div bg-blue-600 text-white font-semibold text-base px-8 py-3 rounded-xl
          "{cta_label}"

    # Footer
    div px-8 py-4 border-t border-zinc-800 flex flex-col gap-1
      div text-xs text-zinc-600 text-center
        "You are receiving this because you signed up for Crepuscularity updates."
      div text-xs text-zinc-700 text-center
        "© 2026 Crepuscularity · All rights reserved"
