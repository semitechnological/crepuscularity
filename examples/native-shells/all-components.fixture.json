{
  "version": 3,
  "root": [
    {
      "kind": "stack",
      "axis": "column",
      "spacing": 16.0,
      "style": {
        "padding": 24.0,
        "foregroundColor": "#111111",
        "backgroundColor": "#ffffff",
        "flexDirection": "column"
      },
      "children": [
        {
          "kind": "text",
          "content": "Native components",
          "style": {
            "fontSize": 24.0,
            "fontWeight": 600
          }
        },
        {
          "kind": "text",
          "content": "Generated by crepus native codegen.",
          "style": {
            "foregroundColor": "#444444"
          }
        },
        {
          "kind": "button",
          "label": "Refresh",
          "onClick": "refresh",
          "style": {
            "paddingHorizontal": 24.0,
            "paddingVertical": 16.0,
            "foregroundColor": "#ffffff",
            "backgroundColor": "#111111"
          }
        },
        {
          "kind": "input",
          "placeholder": "Search notes",
          "bind": "\"note\"",
          "multiline": false
        },
        {
          "kind": "picker",
          "bind": "\"mode\"",
          "options": [
            {
              "value": "home",
              "label": "Home"
            },
            {
              "value": "away",
              "label": "Away"
            }
          ]
        },
        {
          "kind": "toggle",
          "label": "Photos",
          "bind": "photos",
          "checked": true,
          "onChange": "sync.photos"
        },
        {
          "kind": "checkbox",
          "label": "Clipboard",
          "bind": "clipboard",
          "checked": false
        },
        {
          "kind": "slider",
          "label": "Quota",
          "bind": "quota",
          "value": 25.0,
          "min": 0.0,
          "max": 100.0,
          "step": 5.0
        },
        {
          "kind": "progress",
          "label": "Transfer",
          "value": 62.0,
          "max": 100.0
        },
        {
          "kind": "meter",
          "label": "Storage",
          "value": 512.0,
          "min": 0.0,
          "max": 1024.0
        },
        {
          "kind": "badge",
          "label": "Online",
          "tone": "success"
        },
        {
          "kind": "divider",
          "axis": "column"
        },
        {
          "kind": "spacer",
          "size": 16.0
        },
        {
          "kind": "dropzone",
          "label": "Drop files",
          "accept": "image/*,application/pdf",
          "onDrop": "import_files",
          "style": {
            "padding": 16.0,
            "cornerRadius": 6.0,
            "borderWidth": 1.0
          },
          "children": [
            {
              "kind": "text",
              "content": "Drop files",
              "style": {
                "fontSize": 14.0
              }
            }
          ]
        },
        {
          "kind": "filePicker",
          "label": "Choose media",
          "accept": [
            "image/*",
            "video/*"
          ],
          "multiple": true,
          "onPick": "pick_media"
        },
        {
          "kind": "image",
          "src": "https://example.com/acme.png",
          "alt": "Acme preview",
          "placeholder": "Loading image",
          "style": {
            "objectFit": "cover",
            "objectPosition": "center"
          }
        },
        {
          "kind": "stack",
          "axis": "column",
          "style": {
            "padding": 8.0
          },
          "children": [
            {
              "kind": "badge",
              "label": "LAN"
            },
            {
              "kind": "badge",
              "label": "Sync"
            }
          ]
        }
      ]
    }
  ]
}
