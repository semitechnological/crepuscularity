div flex flex-col gap-4 p-6 bg-black text-white
  span text-2xl font-semibold
    "Native components"
  span text-[#b8b8b8]
    "Generated by crepus native codegen."
  button @click="refresh" bg-[#ffffff] text-[#000000] px-6 py-4
    "Refresh"
  input bind=note placeholder="Search notes"
  picker bind=mode
    span value="home" "Home"
    span value="away" "Away"
  toggle bind=photos checked=true @change="sync.photos"
    "Photos"
  checkbox bind=clipboard checked=false
    "Clipboard"
  slider bind=quota value=25 min=0 max=100 step=5 label="Quota"
  progress value=62 max=100 label="Transfer"
  meter value=512 min=0 max=1024 label="Storage"
  badge tone="success"
    "Online"
  divider
  spacer size=16
  dropzone @drop="import_files" accept="image/*,application/pdf" border rounded p-4
    span text-sm
      "Drop files"
  file-picker accept="image/*,video/*" multiple @pick="pick_media" "Choose media"
  img object-cover object-center src="https://example.com/cupboard.png" alt="Cupboard preview" placeholder="Loading image"
  scroll axis="row" p-2
    badge
      "LAN"
    badge
      "Sync"
