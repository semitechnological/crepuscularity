div w-full min-h-screen bg-zinc-950 text-zinc-100 px-6 py-16 flex flex-col gap-10
 div flex flex-col gap-3
  div text-4xl font-bold tracking-tight
   "moon-site"
  div text-lg text-zinc-400 max-w-2xl
   "A Moonshine site whose templates live in Rust. This page is templates/page.crepus, pulled in with include_str!."
 div flex flex-col gap-4
  div text-sm uppercase tracking-widest text-zinc-500
   "Three ways to write a template"
  ul
   li
    "Inline in src/main.rs as a raw string literal."
   li
    "A .crepus file, indentation-based, like this one."
   li
    "A .csx file, JSX-flavoured crepusx."
 div flex flex-col gap-4
  div text-sm uppercase tracking-widest text-zinc-500
   "Links"
  a href="https://crates.io/crates/crepuscularity-cli" text-sky-400 underline
   "crepuscularity-cli on crates.io"
  a href="https://github.com/tschk/moonshine" text-sky-400 underline
   "moonshine on GitHub"
 hr
 div text-sm text-zinc-500
  "Generated from Rust. TypeScript lives in ts/."
 div flex flex-col gap-3 border-t border-zinc-800 pt-6
  div text-sm uppercase tracking-widest text-zinc-500
   "Interactive, driven from this template"
  if {count > 0}
   div text-emerald-400
    "count is above zero"
  else
   div text-zinc-500
    "count is zero"
  button @click=increment
   "increment from .crepus"
  ul
   for tag in {tags}
    li text-zinc-400
     "{tag}"
