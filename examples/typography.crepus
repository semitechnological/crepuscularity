# Typography showcase — all text-related DSL classes.
# Run with: crepus preview examples/typography.crepus

div w-full h-full bg-zinc-950 text-white flex flex-col gap-8 p-10 overflow-y-auto

  div text-2xl font-bold text-white
    "Typography"
  div text-sm text-zinc-500 -mt-6
    "All supported text classes in one place"

  # ── Font Size ──────────────────────────────────────────────────────
  div flex flex-col gap-3
    div text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-1
      "FONT SIZE"
    div flex flex-col gap-2
      div flex items-baseline gap-4
        div text-zinc-500 text-xs w-20
          "text-xs"
        div text-xs text-zinc-200
          "The quick brown fox"
      div flex items-baseline gap-4
        div text-zinc-500 text-xs w-20
          "text-sm"
        div text-sm text-zinc-200
          "The quick brown fox"
      div flex items-baseline gap-4
        div text-zinc-500 text-xs w-20
          "text-base"
        div text-base text-zinc-200
          "The quick brown fox"
      div flex items-baseline gap-4
        div text-zinc-500 text-xs w-20
          "text-lg"
        div text-lg text-zinc-200
          "The quick brown fox"
      div flex items-baseline gap-4
        div text-zinc-500 text-xs w-20
          "text-xl"
        div text-xl text-zinc-200
          "The quick brown fox"
      div flex items-baseline gap-4
        div text-zinc-500 text-xs w-20
          "text-2xl"
        div text-2xl text-zinc-200
          "The quick brown fox"
      div flex items-baseline gap-4
        div text-zinc-500 text-xs w-20
          "text-3xl"
        div text-3xl text-zinc-200
          "The quick brown fox"
      div flex items-baseline gap-4
        div text-zinc-500 text-xs w-20
          "text-4xl"
        div text-4xl text-zinc-200
          "Display"
      div flex items-baseline gap-4
        div text-zinc-500 text-xs w-20
          "text-5xl"
        div text-5xl font-bold text-zinc-200
          "Hero"

  # ── Font Weight ────────────────────────────────────────────────────
  div flex flex-col gap-3
    div text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-1
      "FONT WEIGHT"
    div flex flex-row flex-wrap gap-x-8 gap-y-2
      div flex flex-col items-center gap-1
        div text-zinc-500 text-xs
          "font-thin"
        div text-lg font-thin text-zinc-200
          "Thin"
      div flex flex-col items-center gap-1
        div text-zinc-500 text-xs
          "font-light"
        div text-lg font-light text-zinc-200
          "Light"
      div flex flex-col items-center gap-1
        div text-zinc-500 text-xs
          "font-normal"
        div text-lg font-normal text-zinc-200
          "Normal"
      div flex flex-col items-center gap-1
        div text-zinc-500 text-xs
          "font-medium"
        div text-lg font-medium text-zinc-200
          "Medium"
      div flex flex-col items-center gap-1
        div text-zinc-500 text-xs
          "font-semibold"
        div text-lg font-semibold text-zinc-200
          "Semibold"
      div flex flex-col items-center gap-1
        div text-zinc-500 text-xs
          "font-bold"
        div text-lg font-bold text-zinc-200
          "Bold"
      div flex flex-col items-center gap-1
        div text-zinc-500 text-xs
          "font-extrabold"
        div text-lg font-extrabold text-zinc-200
          "Extrabold"
      div flex flex-col items-center gap-1
        div text-zinc-500 text-xs
          "font-black"
        div text-lg font-black text-zinc-200
          "Black"

  # ── Text Transform (NEW) ──────────────────────────────────────────
  div flex flex-col gap-3
    div text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-1
      "TEXT TRANSFORM"
    div flex flex-col gap-2
      div flex items-center gap-4
        div text-zinc-500 text-xs w-32
          "uppercase"
        div text-base uppercase text-zinc-200
          "the quick brown fox"
      div flex items-center gap-4
        div text-zinc-500 text-xs w-32
          "lowercase"
        div text-base lowercase text-zinc-200
          "THE QUICK BROWN FOX"
      div flex items-center gap-4
        div text-zinc-500 text-xs w-32
          "capitalize"
        div text-base capitalize text-zinc-200
          "the quick brown fox"
      div flex items-center gap-4
        div text-zinc-500 text-xs w-32
          "normal-case"
        div text-base normal-case text-zinc-200
          "The Quick Brown Fox"

  # ── Letter Spacing / Tracking (NEW) ──────────────────────────────
  div flex flex-col gap-3
    div text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-1
      "LETTER SPACING"
    div flex flex-col gap-2
      div flex items-center gap-4
        div text-zinc-500 text-xs w-28
          "tracking-tighter"
        div text-base tracking-tighter text-zinc-200
          "Crepuscularity"
      div flex items-center gap-4
        div text-zinc-500 text-xs w-28
          "tracking-tight"
        div text-base tracking-tight text-zinc-200
          "Crepuscularity"
      div flex items-center gap-4
        div text-zinc-500 text-xs w-28
          "tracking-normal"
        div text-base tracking-normal text-zinc-200
          "Crepuscularity"
      div flex items-center gap-4
        div text-zinc-500 text-xs w-28
          "tracking-wide"
        div text-base tracking-wide text-zinc-200
          "Crepuscularity"
      div flex items-center gap-4
        div text-zinc-500 text-xs w-28
          "tracking-wider"
        div text-base tracking-wider text-zinc-200
          "Crepuscularity"
      div flex items-center gap-4
        div text-zinc-500 text-xs w-28
          "tracking-widest"
        div text-base tracking-widest uppercase text-zinc-200
          "Crepuscularity"

  # ── Text Color ────────────────────────────────────────────────────
  div flex flex-col gap-3
    div text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-1
      "TEXT COLOR"
    div flex flex-row flex-wrap gap-x-6 gap-y-2
      div text-white font-semibold
        "text-white"
      div text-zinc-300 font-semibold
        "text-zinc-300"
      div text-zinc-500 font-semibold
        "text-zinc-500"
      div text-blue-400 font-semibold
        "text-blue-400"
      div text-sky-400 font-semibold
        "text-sky-400"
      div text-emerald-400 font-semibold
        "text-emerald-400"
      div text-amber-400 font-semibold
        "text-amber-400"
      div text-rose-400 font-semibold
        "text-rose-400"
      div text-violet-400 font-semibold
        "text-violet-400"

  # ── Line Height ───────────────────────────────────────────────────
  div flex flex-col gap-3
    div text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-1
      "LINE HEIGHT"
    div flex flex-row gap-8
      div flex flex-col gap-1
        div text-zinc-500 text-xs mb-1
          "leading-none"
        div text-sm leading-none text-zinc-200 bg-zinc-900 p-2 rounded w-32
          "Line one\nLine two\nLine three"
      div flex flex-col gap-1
        div text-zinc-500 text-xs mb-1
          "leading-tight"
        div text-sm leading-tight text-zinc-200 bg-zinc-900 p-2 rounded w-32
          "Line one\nLine two\nLine three"
      div flex flex-col gap-1
        div text-zinc-500 text-xs mb-1
          "leading-normal"
        div text-sm leading-normal text-zinc-200 bg-zinc-900 p-2 rounded w-32
          "Line one\nLine two\nLine three"
      div flex flex-col gap-1
        div text-zinc-500 text-xs mb-1
          "leading-relaxed"
        div text-sm leading-relaxed text-zinc-200 bg-zinc-900 p-2 rounded w-32
          "Line one\nLine two\nLine three"
      div flex flex-col gap-1
        div text-zinc-500 text-xs mb-1
          "leading-loose"
        div text-sm leading-loose text-zinc-200 bg-zinc-900 p-2 rounded w-32
          "Line one\nLine two\nLine three"
