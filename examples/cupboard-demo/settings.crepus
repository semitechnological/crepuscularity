div w-full h-full bg-zinc-950 text-white p-8 flex flex-col gap-6
  div text-2xl font-bold
    "Settings"
  include ui-library/ui-library.crepus#Panel title="Sync" collapsible=true defaultExpanded=true
    div flex flex-col gap-4
      label flex items-center gap-3
        input type="checkbox" checked={syncPhotos}
        "Sync photos"
      label flex items-center gap-3
        input type="checkbox" checked={syncClipboard}
        "Sync clipboard"
  include ui-library/ui-library.crepus#Panel title="Storage" collapsible=true defaultExpanded=false
    div flex flex-col gap-4
      label text-sm text-zinc-400
        "Storage quota"
      input type="range" min=0 max=100 value={quota}
