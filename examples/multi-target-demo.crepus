# Multi-target demo — same template, multiple backends.
# Try: crepus render multi-target-demo.crepus --ctx demo-context.json
# Try: crepus native ir multi-target-demo.crepus --ctx demo-context.json --pretty

div w-full h-full bg-zinc-950 text-white flex flex-col p-8 gap-6

  # Header with conditional badge
  div flex items-center gap-4

    div text-3xl font-bold #name-title
      "{name}"

    if {score >= 90}
      div bg-emerald-500 text-white text-xs font-bold px-3 py-1 rounded-full
        "EXCELLENT"
    else if {score >= 70}
      div bg-amber-500 text-white text-xs font-bold px-3 py-1 rounded-full
        "GOOD"
    else
      div bg-red-500 text-white text-xs font-bold px-3 py-1 rounded-full
        "NEEDS WORK"

  # Score display with match
  div flex flex-col gap-2

    div text-lg text-zinc-400
      "Performance Score"

    match {status}
    "winning" =>
      div text-2xl font-bold text-emerald-400 "🏆 {score}/100 — Winning!"
    "losing" =>
      div text-2xl font-bold text-red-400 "💥 {score}/100 — Needs attention"
    _ =>
      div text-2xl font-bold text-amber-400 "⚡ {score}/100 — Stable"

  # Simple for loop
  div flex flex-col gap-1

    div text-sm text-zinc-500
      "Items"

    for item in {items}
      div px-2 py-1 "{item}"