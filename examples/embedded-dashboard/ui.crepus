motion w-full h-full flex flex-col bg-zinc-900 p-2 gap-2
 div flex-row w-full gap-2 items-center
  span text-zinc-400
   "CPU"
  span flex-1 text-green-400 font-bold #cpu-value
   "{cpu}%"
 div flex-row w-full gap-2 items-center
  span text-zinc-400
   "Status"
  span flex-1 text-white #status-label
   "{status}"
