<style>
@property --cp-bg { syntax: '<color>'; inherits: true; initial-value: #e3e9f5; }
@property --cp-fg { syntax: '<color>'; inherits: true; initial-value: #15101f; }
@property --cp-muted { syntax: '<color>'; inherits: true; initial-value: #4e4a5c; }
@property --cp-border { syntax: '<color>'; inherits: true; initial-value: #959eb2; }
