google-fonts "Inter" "JetBrains Mono"

div min-h-screen overflow-x-hidden antialiased crepus-twilight-page
 main max-w-[896px] sm:max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 min-w-0
  div flex items-center gap-3 pt-6 sm:pt-8 pb-2 crepus-entrance crepus-e1
   a href="./index.html" flex items-center gap-3 group shrink-0 no-underline crepus-t-text hover:opacity-90
    img src="./static/favicon.svg" alt="" w-9 h-9 sm:w-10 sm:h-10 shrink-0 rounded-lg
    span text-sm sm:text-base font-semibold tracking-tight
     "Crepuscularity"
  section pt-6 pb-12 sm:pt-10 sm:pb-20 md:pt-12 md:pb-24 crepus-entrance crepus-e2
   div grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_min(100%,380px)] gap-6 sm:gap-8 lg:gap-12 items-start
    div max-w-3xl min-w-0
     h1 text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold crepus-t-text tracking-tight leading-[1.08] mb-4 sm:mb-6
      "UI templates that compile "
      span font-extrabold border-b-2 pb-0.5 crepus-t-icon border-[var(--cp-accent)]
       "everywhere"
     p text-base sm:text-lg md:text-xl crepus-t-muted leading-relaxed max-w-2xl mb-6 sm:mb-10
      span
       "Describe interfaces in "
      code text-sm sm:text-base crepus-t-text opacity-90
       ".crepus"
      span
       " — indentation or JSX-style input, same AST — and target native GPUI, static WASM sites, HTML, or Manifest V3 extensions from one CLI."
     div flex flex-wrap gap-3 items-start flex-col sm:flex-row sm:items-center mb-6 sm:mb-0
      a href="./docs/index.html" no-underline inline-flex items-center gap-2 px-5 py-2.5 rounded-lg crepus-t-btn-primary text-sm font-semibold
       "Browse documentation"
       span opacity-80
        "→"
      a href="./docs/cli.html" no-underline inline-flex items-center px-5 py-2.5 rounded-lg crepus-t-btn-ghost text-sm font-medium transition-colors hover:bg-[var(--cp-elevated)]
       "CLI reference"
     div mt-4 sm:mt-8 flex flex-col items-stretch w-full max-w-xl gap-4 sm:gap-5
      p text-xs font-semibold uppercase tracking-widest crepus-t-muted m-0 text-center sm:text-left
       "One toolchain"
      div grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-5 text-center
       div flex flex-col items-center gap-2
        span material-symbols-outlined crepus-toolchain-icon text-[var(--cp-accent)]
         "computer"
        span text-xs crepus-t-muted leading-snug
         "Desktop"
       div flex flex-col items-center gap-2
        span material-symbols-outlined crepus-toolchain-icon text-[var(--cp-accent)]
         "public"
        span text-xs crepus-t-muted leading-snug
         "Internet"
       div flex flex-col items-center gap-2
        span material-symbols-outlined crepus-toolchain-icon text-[var(--cp-accent)]
         "web"
        span text-xs crepus-t-muted leading-snug
         "Chrome"
       div flex flex-col items-center gap-2
        span material-symbols-outlined crepus-toolchain-icon text-[var(--cp-accent)]
         "smartphone"
        span text-xs crepus-t-muted leading-snug
         "Mobile"
      p text-sm crepus-t-muted leading-relaxed m-0 text-center sm:text-left
       "Crepuscularity Lite is a sibling project: a GPUI + V8 desktop shell with a Capacitor-shaped Rust bridge for embedding web UI in native apps — pair it with this CLI when you want a lighter native host than a full GPUI template tree."
      a href="https://github.com/semitechnological/crepuscularity-lite" no-underline text-sm font-medium crepus-t-text hover:opacity-85 border-b crepus-t-border transition-colors inline-block self-center sm:self-start rel="noopener noreferrer" target="_blank"
       "Crepuscularity Lite on GitHub →"
    div w-full min-w-0 mx-auto lg:mx-0 lg:justify-self-end order-last lg:order-none
     div rounded-xl border overflow-hidden shadow-xl crepus-t-border crepus-t-card
      div flex items-center gap-2 px-3 sm:px-4 py-2.5 sm:py-3 border-b crepus-t-border bg-[var(--cp-code)]
       span flex gap-1.5 shrink-0
        span w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full opacity-50 bg-[var(--cp-muted)]
        span w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full opacity-40 bg-[var(--cp-muted)]
        span w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full opacity-30 bg-[var(--cp-muted)]
       span text-xs font-mono crepus-t-muted ml-1 truncate
        "terminal"
       pre font-mono text-[11px] sm:text-[13px] leading-relaxed p-3 sm:p-4 m-0 crepus-t-pre whitespace-pre overflow-x-visible
         "# New desktop app\n$ crepus new my-app && cargo run\n\n# WASM site (this page)\n$ crepus web build --site docs-site\n\n# Browser extension\n$ crepus webext new ext"

  section py-10 sm:py-14 border-t crepus-t-border crepus-entrance crepus-e3
   div flex flex-col lg:flex-row lg:items-stretch gap-5 sm:gap-6 lg:gap-8
    div flex-1 rounded-xl p-5 sm:p-8 crepus-t-card
     p text-xs font-semibold uppercase tracking-widest crepus-t-muted mb-3 sm:mb-4
      "Why it's different"
      p text-xl sm:text-2xl md:text-3xl font-semibold crepus-t-text leading-snug mb-4 sm:mb-5 transition-all duration-300 ease-in-out
      slot-rotate interval={3000} slot-lede
       "Hot-reloadable templates on GPUI."
       "No JS bundler for extensions."
       "Compile-time view! or full runtime parse."
       "Ship static dist/ to any CDN."
     p text-sm crepus-t-muted m-0 leading-relaxed
      "The same parser and evaluator back the macro, the WASM renderer, and the dev server — so what you author is what ships."
     div mt-5 inline-flex items-center gap-2 rounded-full border px-3 py-1.5 crepus-t-card crepus-t-text text-xs font-semibold uppercase tracking-[0.18em]
      span w-2 h-2 rounded-full bg-[var(--cp-accent)] shrink-0
      "One workspace"
     p text-sm crepus-t-muted leading-relaxed mt-4 mb-0
      "Ship Manifest V3 browser extensions without a separate front-end toolchain. The same templates power native GPUI windows, static WASM sites, and extension popups, with instant dev reload and a layout path that stays on the GPU instead of funneling every interaction through a JS runtime."
    div flex-1 grid gap-4 sm:grid-cols-2
     div rounded-xl p-4 sm:p-5 crepus-t-card
      h3 text-sm font-semibold crepus-t-text mb-2
       "One syntax"
      p text-xs crepus-t-muted leading-relaxed m-0
       "Indent or JSX-style tags; control flow, slots, and includes behave the same across backends."
     div rounded-xl p-4 sm:p-5 crepus-t-card
      h3 text-sm font-semibold crepus-t-text mb-2
       "Rust + WASM"
      p text-xs crepus-t-muted leading-relaxed m-0
       "Thin wasm32 runtimes, optional reactive layer, and HTML output for SSR and extensions."
     div rounded-xl p-4 sm:p-5 crepus-t-card
      h3 text-sm font-semibold crepus-t-text mb-2
       "Tailwind on GPUI"
      p text-xs crepus-t-muted leading-relaxed m-0
       "Class strings map to native styles — layout, color, type, and more (see README)."
     div rounded-xl p-4 sm:p-5 crepus-t-card
      h3 text-sm font-semibold crepus-t-text mb-2
       "Documentation site"
      p text-xs crepus-t-muted leading-relaxed m-0
       "Markdown in docs/ is rendered to styled HTML on every crepus web build."

  section py-10 sm:py-14 border-t crepus-t-border crepus-entrance crepus-e4
   h2 text-lg font-semibold crepus-t-text mb-2
    "Three ways to write the same tree"
   p text-sm crepus-t-muted mb-2 max-w-2xl m-0
    "Curly braces in snippets use Unicode ｛ ｝ where the real sources use ASCII so this page stays valid .crepus."
   p text-sm crepus-t-muted mb-8 max-w-2xl m-0
    "Indent DSL, TSX-shaped tags, or GPUI’s compile-time macro — one AST, your pick."
   div grid gap-4 grid-cols-1 lg:grid-cols-3
    div rounded-xl p-4 flex flex-col crepus-t-card
     p text-xs font-semibold crepus-t-muted uppercase tracking-wide mb-2 m-0
      "Indent · .crepus"
     pre font-mono text-[10px] sm:text-xs m-0 flex-1 leading-relaxed crepus-t-pre p-3 rounded-lg whitespace-pre-wrap overflow-x-auto
      "div flex flex-col gap-3\n  div text-xl font-bold\n   \"Hello ｛name｝\""
    div rounded-xl p-4 flex flex-col crepus-t-card
     p text-xs font-semibold crepus-t-muted uppercase tracking-wide mb-2 m-0
      "JSX-style tags"
     pre font-mono text-[10px] sm:text-xs m-0 flex-1 leading-relaxed crepus-t-pre p-3 rounded-lg whitespace-pre-wrap overflow-x-auto
      "<div class=\"flex flex-col gap-3\">\n  <div class=\"text-xl font-bold\">\n    Hello ｛name｝\n  </div>\n</div>"
    div rounded-xl p-4 flex flex-col crepus-t-card
     p text-xs font-semibold crepus-t-muted uppercase tracking-wide mb-2 m-0
      "GPUI · view!"
     pre font-mono text-[10px] sm:text-xs m-0 flex-1 leading-relaxed crepus-t-pre p-3 rounded-lg whitespace-pre-wrap overflow-x-auto
      "use crepuscularity::prelude::*;\n\nfn ui(cx: &mut ViewContext) -> impl IntoElement {\n    view!(cx,\n        div(class=\"flex items-center gap-2 p-4 font-bold\") ｛\n            \"Hello from GPUI and Rust\",\n        ｝\n    )\n}"

  section py-10 sm:py-14 border-t crepus-t-border
   div flex flex-col md:flex-row md:items-end md:justify-between gap-5 sm:gap-6 mb-7 sm:mb-10
    div
     h2 text-lg font-semibold crepus-t-text mb-1
      "Documentation"
     p text-sm crepus-t-muted m-0 max-w-xl
      "Guides are edited as Markdown in the repo and published as HTML alongside this landing page."
    a href="./docs/index.html" no-underline text-sm font-medium crepus-t-text hover:opacity-85 transition-colors border-b border-transparent hover:border-[var(--cp-accent)]
     "View all →"
   div grid gap-4 sm:grid-cols-2 lg:grid-cols-4
    a href="./docs/dsl.html" doc-card no-underline crepus-t-text hover:opacity-95
     span text-xs font-mono crepus-t-muted
      "dsl.md"
     span text-base font-semibold mt-2 block
      "DSL reference"
     span text-xs crepus-t-muted mt-1 block
      "Syntax, flow, attributes"
    a href="./docs/components.html" doc-card no-underline crepus-t-text hover:opacity-95
     span text-xs font-mono crepus-t-muted
      "components.md"
     span text-base font-semibold mt-2 block
      "Components"
     span text-xs crepus-t-muted mt-1 block
      "Includes & slots"
    a href="./docs/cli.html" doc-card no-underline crepus-t-text hover:opacity-95
     span text-xs font-mono crepus-t-muted
      "cli.md"
     span text-base font-semibold mt-2 block
      "CLI"
     span text-xs crepus-t-muted mt-1 block
      "Commands & flags"
    a href="./docs/webext.html" doc-card no-underline crepus-t-text hover:opacity-95
     span text-xs font-mono crepus-t-muted
      "webext.md"
     span text-base font-semibold mt-2 block
      "Extensions"
     span text-xs crepus-t-muted mt-1 block
      "MV3 toolchain"

 footer border-t py-8 sm:py-10 crepus-t-border crepus-entrance crepus-e6
  div max-w-full sm:max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 footer-row
   div flex flex-col gap-2
    a href="./index.html" flex items-center gap-2 no-underline crepus-t-text hover:opacity-90
     img src="./static/favicon.svg" alt="" w-7 h-7 shrink-0 rounded-md
     span text-sm font-medium
      "Crepuscularity"
    span text-xs crepus-t-muted
     "MPL-2.0 — built with crepuscularity-web"
   nav flex flex-wrap gap-x-5 gap-y-2 text-xs crepus-t-muted items-center justify-start sm:justify-end
    a href="./docs/index.html" no-underline crepus-t-muted hover:text-[var(--cp-fg)] transition-colors
     "Docs"
    a href="https://crates.io/crates/crepuscularity" no-underline crepus-t-muted hover:text-[var(--cp-fg)] transition-colors rel="noopener noreferrer" target="_blank"
     "Crates"
    a href="https://github.com/semitechnological/crepuscularity-lite" no-underline crepus-t-muted hover:text-[var(--cp-fg)] transition-colors rel="noopener noreferrer" target="_blank"
     "Lite"
    a href="https://github.com/semitechnological/crepuscularity" no-underline crepus-t-muted hover:text-[var(--cp-fg)] transition-colors rel="noopener noreferrer" target="_blank"
     "GitHub"

.slot-lede text-[var(--cp-fg)] font-medium
.footer-row flex flex-col sm:flex-row justify-between gap-4 sm:gap-6 sm:items-center
.doc-card group flex flex-col rounded-xl p-4 sm:p-5 transition-all crepus-t-card hover:border-[var(--cp-accent)]
