.crepus-e6 { animation-delay: 0.35s; }
.animate-sunset {
  position: relative;
  overflow: hidden;
  background: linear-gradient(to bottom right, #1f1f23, #121217, #08080b);
}
.animate-sunset::before,
.animate-sunset::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  opacity: 0;
}
.animate-sunset::before {
  background: linear-gradient(to bottom right, #4a251f, #7a3b1f, #2a1420);
  animation: sunset-warm 24s ease-in-out infinite;
}
.animate-sunset::after {
  background: linear-gradient(to bottom right, #3a1d33, #522a54, #1d1126);
  animation: sunset-violet 24s ease-in-out infinite;
}
.animate-sunset > * {
  position: relative;
  z-index: 1;
}
@keyframes sunset-warm {
  0%, 100% { opacity: 0; }
  22%, 46% { opacity: 1; }
  68% { opacity: 0; }
}
@keyframes sunset-violet {
  0%, 46%, 100% { opacity: 0; }
  68%, 88% { opacity: 1; }
}
