				img src="./static/favicon.svg" alt="" w-9 h-9 sm:w-10 sm:h-10 shrink-0 rounded-lg
				span text-sm sm:text-base font-semibold tracking-tight
					"Crepuscularity"
		section pt-14 pb-12 sm:pt-16 sm:pb-20 md:pt-20 md:pb-24 crepus-entrance crepus-e2 bg-gradient-to-br from-zinc-950 via-zinc-900 to-black rounded-2xl p-6 sm:p-8 lg:p-12 animate-sunset
			div grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_min(100%,450px)] gap-6 sm:gap-8 lg:gap-12 items-start
				div max-w-3xl min-w-0
					h1 text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold crepus-t-text tracking-tight leading-[1.08] mb-4 sm:mb-6 text-pretty
						"UI templates that compile "
						span font-extrabold border-b-2 pb-0.5 crepus-t-icon border-[var(--cp-accent)]
							"everywhere"
					p text-base sm:text-lg md:text-xl crepus-t-muted leading-relaxed max-w-2xl mb-6 sm:mb-10
						span
							"Describe interfaces in "
						code text-sm sm:text-base crepus-t-text opacity-90
							".crepus"
						span
							" — indentation or JSX-style input, same AST — and target native GPUI, static WASM sites, HTML, Manifest V3 extensions, RGB565 embedded displays, or LVGL Pro XML from one CLI."
					div flex flex-wrap gap-3 items-start flex-col sm:flex-row sm:items-center mb-6 sm:mb-0
						a href="./docs/index.html" no-underline inline-flex items-center gap-2 px-5 py-2.5 rounded-lg crepus-t-btn-primary text-sm font-semibold
							"Browse documentation"
							span opacity-80
								"→"
						a href="./docs/cli.html" no-underline inline-flex items-center px-5 py-2.5 rounded-lg crepus-t-btn-ghost text-sm font-medium transition-colors hover:bg-[var(--cp-elevated)]
							"CLI reference"
					div mt-4 sm:mt-8 flex flex-col items-stretch w-full max-w-xl gap-4 sm:gap-5
						p text-xs font-semibold uppercase tracking-widest crepus-t-muted m-0 text-center sm:text-left
							"One toolchain"
						div grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-5 text-center
							div flex flex-col items-center gap-2
								span material-symbols-outlined crepus-toolchain-icon text-[var(--cp-accent)]
									"computer"
								span text-xs crepus-t-muted leading-snug
									"Desktop"
							div flex flex-col items-center gap-2
								span material-symbols-outlined crepus-toolchain-icon text-[var(--cp-accent)]
									"public"
								span text-xs crepus-t-muted leading-snug
									"Internet"
