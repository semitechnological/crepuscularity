google-fonts "Inter" "JetBrains Mono" "Material Symbols Outlined"

div min-h-screen overflow-x-hidden antialiased crepus-twilight-page
	main max-w-[896px] sm:max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 min-w-0
		div flex items-center gap-3 pt-6 sm:pt-8 pb-2 crepus-entrance crepus-e1
			a href="./index.html" flex items-center gap-3 group shrink-0 no-underline crepus-t-text hover:opacity-90
				img src="./static/favicon.svg" alt="" w-9 h-9 sm:w-10 sm:h-10 shrink-0 rounded-lg
				span text-sm sm:text-base font-semibold tracking-tight
					"Crepuscularity"
		section pt-14 pb-12 sm:pt-16 sm:pb-20 md:pt-20 md:pb-24 crepus-entrance crepus-e2 bg-gradient-to-br from-zinc-950 via-zinc-900 to-black rounded-2xl p-6 sm:p-8 lg:p-12 animate-sunset
			div grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_min(100%,450px)] gap-6 sm:gap-8 lg:gap-12 items-start
				div max-w-3xl min-w-0
					h1 text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold crepus-t-text tracking-tight leading-[1.08] mb-4 sm:mb-6 text-pretty
						"UI templates that compile "
						span font-extrabold border-b-2 pb-0.5 crepus-t-icon border-[var(--cp-accent)]
							"everywhere"
					p text-base sm:text-lg md:text-xl crepus-t-muted leading-relaxed max-w-2xl mb-6 sm:mb-10
						span
							"Describe interfaces in "
						code text-sm sm:text-base crepus-t-text opacity-90
							".crepus"
						span
							" — indentation or JSX-style input, same AST — and target native GPUI, static WASM sites, HTML, Manifest V3 extensions, RGB565 embedded displays, or LVGL Pro XML from one CLI."
					div flex flex-wrap gap-3 items-start flex-col sm:flex-row sm:items-center mb-6 sm:mb-0
						a href="./docs/index.html" no-underline inline-flex items-center gap-2 px-5 py-2.5 rounded-lg crepus-t-btn-primary text-sm font-semibold
							"Browse documentation"
							span opacity-80
								"→"
						a href="./docs/cli.html" no-underline inline-flex items-center px-5 py-2.5 rounded-lg crepus-t-btn-ghost text-sm font-medium transition-colors hover:bg-[var(--cp-elevated)]
							"CLI reference"
					div mt-4 sm:mt-8 flex flex-col items-stretch w-full max-w-xl gap-4 sm:gap-5
						p text-xs font-semibold uppercase tracking-widest crepus-t-muted m-0 text-center sm:text-left
							"One toolchain"
						div grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-5 text-center
							div flex flex-col items-center gap-2
								span material-symbols-outlined crepus-toolchain-icon text-[var(--cp-accent)]
									"computer"
								span text-xs crepus-t-muted leading-snug
									"Desktop"
							div flex flex-col items-center gap-2
								span material-symbols-outlined crepus-toolchain-icon text-[var(--cp-accent)]
									"public"
								span text-xs crepus-t-muted leading-snug
									"Internet"
							div flex flex-col items-center gap-2
								span material-symbols-outlined crepus-toolchain-icon text-[var(--cp-accent)]
									"web"
								span text-xs crepus-t-muted leading-snug
									"Chrome"
							div flex flex-col items-center gap-2
								span material-symbols-outlined crepus-toolchain-icon text-[var(--cp-accent)]
									"smartphone"
								span text-xs crepus-t-muted leading-snug
									"Mobile"
							div flex flex-col items-center gap-2
								span material-symbols-outlined crepus-toolchain-icon text-[var(--cp-accent)]
									"developer_board"
								span text-xs crepus-t-muted leading-snug
									"Embedded"
							div flex flex-col items-center gap-2
								span material-symbols-outlined crepus-toolchain-icon text-[var(--cp-accent)]
									"dashboard"
								span text-xs crepus-t-muted leading-snug
									"LVGL"
						p text-sm crepus-t-muted leading-relaxed m-0 text-center sm:text-left
							"Crepuscularity Lite: a GPUI + V8 desktop shell as a drop in replacement for Electron to work as native apps."
						a href="./docs/lite.html" no-underline text-sm font-medium crepus-t-text guide-link self-center sm:self-start
							span
								"Crepuscularity Lite guide"
							span guide-link-arrow
								"→"
				div w-full min-w-0 mx-auto lg:mx-0 lg:place-self-center order-last lg:order-none min-h-[400px]
					div rounded-xl border overflow-hidden shadow-xl crepus-t-border crepus-t-card
						div flex items-center gap-2 px-3 sm:px-4 py-2.5 sm:py-3 border-b crepus-t-border bg-[var(--cp-code)]
							span flex gap-1.5 shrink-0
								span w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full opacity-50 bg-[var(--cp-muted)]
								span w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full opacity-40 bg-[var(--cp-muted)]
								span w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full opacity-30 bg-[var(--cp-muted)]
							span text-xs font-mono crepus-t-muted ml-1 truncate
								"terminal"
						pre font-mono text-[11px] sm:text-[13px] leading-relaxed p-3 sm:p-4 m-0 crepus-t-pre whitespace-pre overflow-x-visible
							"# New desktop app
$ crepus new my-app && crepus dev

# WASM site (this page)
$ crepus web new my-web && crepus web dev

# Browser extension
$ crepus webext new my-ext && crepus webext dev

# SwiftUI apps (macOS / iOS)
$ crepus aurora new my-ios && crepus aurora dev
"

		section py-10 sm:py-14 border-t crepus-t-border crepus-entrance crepus-e3
			div flex flex-col lg:flex-row lg:items-stretch gap-5 sm:gap-6 lg:gap-8
				div flex-1 rounded-xl p-5 sm:p-8 crepus-t-card
					p text-xs font-semibold uppercase tracking-widest crepus-t-muted mb-3 sm:mb-4
						"Native UI from one source"
					p text-lg sm:text-xl font-medium crepus-t-text leading-relaxed mb-4 sm:mb-5
						"Aurorality transforms .crepus templates into native SwiftUI views for macOS and iOS — no WebView, no JavaScript bridge."
					p text-sm crepus-t-muted m-0 leading-relaxed
						"Semantic tags like navigationstack, sidebar, list, and menu compile to their SwiftUI equivalents. Add eventSink callbacks for app-state integration, wire Rust backends through UniFFI, and hot-reload through the same crepus dev pipeline that serves GPUI and WASM targets."
				div flex-1 rounded-xl p-5 sm:p-8 crepus-t-card
					p text-xs font-semibold uppercase tracking-widest crepus-t-muted mb-3 sm:mb-4
						"SwiftUI Engine"
					pre font-mono text-sm m-0 leading-relaxed crepus-t-pre p-4 sm:p-5 rounded-lg whitespace-pre-wrap overflow-x-auto
						"navigationsplitview\n  sidebar\n    section header=\"Conversations\"\n      for conv in {conversations}\n        item @click=\"select:{conv.id}\"\n          span \"{conv.title}\"\n  detail\n    vstack gap-3 p-4\n      textfield bind=draft placeholder=\"Message\"\n      button button-prominent @click=\"send\"\n        \"Send\""
				div flex-1 rounded-xl p-5 sm:p-8 crepus-t-card
					p text-xs font-semibold uppercase tracking-widest crepus-t-muted mb-3 sm:mb-4
						"Capabilities"
					div flex flex-col gap-3
						div flex items-start gap-3
							span text-xs crepus-t-muted leading-snug mt-0.5
								"•"
							div
								p text-sm font-medium crepus-t-text m-0
									"Semantic native tags"
								p text-xs crepus-t-muted m-0 leading-relaxed
									"navigationstack, sidebar, form, picker, sf-*, and more — all compile to direct SwiftUI views."
						div flex items-start gap-3
							span text-xs crepus-t-muted leading-snug mt-0.5
								"•"
							div
								p text-sm font-medium crepus-t-text m-0
									"macOS chrome"
								p text-xs crepus-t-muted m-0 leading-relaxed
									"Root-level menubar and dockbadge for native menu commands and dock badges."
						div flex items-start gap-3
							span text-xs crepus-t-muted leading-snug mt-0.5
								"•"
							div
								p text-sm font-medium crepus-t-text m-0
									"Hot-reload IR & swiftgen"
								p text-xs crepus-t-muted m-0 leading-relaxed
									"crepus dev pushes JSON IR updates or re-runs swiftgen on save — same dev loop as every other target."
						div flex items-start gap-3
							span text-xs crepus-t-muted leading-snug mt-0.5
								"•"
							div
								p text-sm font-medium crepus-t-text m-0
									"Rust ↔ Swift bridge"
								p text-xs crepus-t-muted m-0 leading-relaxed
									"Plug Rust backends through UniFFI with eventSink wiring for shared state models."
					div mt-4 sm:mt-5
						a href="./docs/aurorality.html" no-underline text-sm font-medium crepus-t-text guide-link
							span
								"Aurorality guide"
							span guide-link-arrow
								"→"

		section py-10 sm:py-14 border-t crepus-t-border crepus-entrance crepus-e4
			div flex flex-col lg:flex-row lg:items-stretch gap-5 sm:gap-6 lg:gap-8
				div flex-1 rounded-xl p-5 sm:p-8 crepus-t-card
					p text-xs font-semibold uppercase tracking-widest crepus-t-muted mb-3 sm:mb-4
						"Why it's different"
					p text-xl sm:text-2xl md:text-3xl font-semibold crepus-t-text leading-snug mb-4 sm:mb-5
						slot-rotate interval={3000} slot-lede
							"Hot-reloadable templates on GPUI."
							"No JS bundler for extensions."
							"Compile-time view! or full runtime parse."
							"Ship static dist/ to any CDN."
					p text-sm crepus-t-muted m-0 leading-relaxed
						"The same parser and evaluator back the macro, the WASM renderer, and the dev server — so what you author is what ships."
					div mt-5 inline-flex items-center gap-2 rounded-full border px-3 py-1.5 crepus-t-card crepus-t-text text-xs font-semibold uppercase tracking-[0.18em]
						span w-2 h-2 rounded-full bg-[var(--cp-accent)] shrink-0
						"One workspace"
					p text-sm crepus-t-muted leading-relaxed mt-4 mb-0
						"Crepuscularity is a compiler surface, runtime surface, and target manifest in one workspace. Templates stay declarative, target-specific renderers stay explicit, and the CLI keeps build outputs reproducible across app shells, websites, extensions, terminals, panels, and generated UI artifacts."
				div flex-1 grid gap-4 sm:grid-cols-2
					div rounded-xl p-4 sm:p-5 crepus-t-card
						h3 text-sm font-semibold crepus-t-text mb-2
							"Shared AST"
						p text-xs crepus-t-muted leading-relaxed m-0
							"Indent and JSX-style input parse into the same node tree, so components, control flow, includes, slots, and defaults travel together."
					div rounded-xl p-4 sm:p-5 crepus-t-card
						h3 text-sm font-semibold crepus-t-text mb-2
							"Target manifests"
						p text-xs crepus-t-muted leading-relaxed m-0
							"`crepus.toml` describes build outputs for web, webext, native IR, LVGL, and embedded snapshots without splitting the project model."
					div rounded-xl p-4 sm:p-5 crepus-t-card
						h3 text-sm font-semibold crepus-t-text mb-2
							"Runtime or compile time"
						p text-xs crepus-t-muted leading-relaxed m-0
							"Use `view!` when the UI is static, or parse templates at runtime when includes, hot reload, or external files matter."
					div rounded-xl p-4 sm:p-5 crepus-t-card
						h3 text-sm font-semibold crepus-t-text mb-2
							"Renderer contracts"
						p text-xs crepus-t-muted leading-relaxed m-0
							"Each backend maps the same template semantics into its native output: GPUI styles, HTML, Ratatui widgets, JSON IR, RGB565, or XML."
					div rounded-xl p-4 sm:p-5 crepus-t-card
						h3 text-sm font-semibold crepus-t-text mb-2
							"Framework-owned docs"
						p text-xs crepus-t-muted leading-relaxed m-0
							"Markdown guides and this landing page are built by the same docs-site pipeline, so the public site exercises the framework it documents."
					div rounded-xl p-4 sm:p-5 crepus-t-card
						h3 text-sm font-semibold crepus-t-text mb-2
							"Small host boundary"
						p text-xs crepus-t-muted leading-relaxed m-0
							"Apps keep ownership of state, event loops, firmware drivers, and platform APIs while Crepuscularity owns template parsing and rendering."

		section py-10 sm:py-14 border-t crepus-t-border crepus-entrance crepus-e5
			h2 text-lg font-semibold crepus-t-text mb-2
				"Three ways to write the same tree"
			p text-sm crepus-t-muted mb-2 max-w-2xl m-0
				"Curly braces in snippets use Unicode ｛ ｝ where the real sources use ASCII so this page stays valid .crepus."
			p text-sm crepus-t-muted mb-8 max-w-2xl m-0
				"Indent DSL, TSX-shaped tags, or GPUI's compile-time macro — one AST, your pick."
			div grid gap-6 grid-cols-1 lg:grid-cols-3 items-stretch
				div rounded-xl p-6 flex flex-col crepus-t-card h-full
					p text-xs font-semibold crepus-t-muted uppercase tracking-wide mb-4 m-0
						"Indent · .crepus"
					pre font-mono text-sm m-0 flex-1 leading-relaxed crepus-t-pre p-6 rounded-lg whitespace-pre-wrap overflow-x-auto bg-[var(--cp-code)]
						"div flex gap-3\n  button @click=\"handle_click\" text-blue-500\n    \"Click me\"\n  input type=\"text\" value=｛input_value｝ placeholder=\"Type here\""
				div rounded-xl p-6 flex flex-col crepus-t-card h-full
					p text-xs font-semibold crepus-t-muted uppercase tracking-wide mb-4 m-0
						"JSX-style tags"
					pre font-mono text-sm m-0 flex-1 leading-relaxed crepus-t-pre p-6 rounded-lg whitespace-pre-wrap overflow-x-auto bg-[var(--cp-code)]
						"<div class=\"flex gap-3\">\n  <button @click=\"handle_click\" class=\"text-blue-500\">Click me</button>\n  <input type=\"text\" value=｛input_value｝ placeholder=\"Type here\" />\n</div>"
				div rounded-xl p-6 flex flex-col crepus-t-card h-full
					p text-xs font-semibold crepus-t-muted uppercase tracking-wide mb-4 m-0
						"GPUI · view!"
					pre font-mono text-sm m-0 flex-1 leading-relaxed crepus-t-pre p-6 rounded-lg whitespace-pre-wrap overflow-x-auto bg-[var(--cp-code)]
						"view!(cx, div().flex().gap_3().child(\n  button().on_click(cx, handle_click).label(\"Click me\").text_color(gpui::blue())\n).child(\n  text_input().text(input_value).placeholder(\"Type here\")\n))"

		section py-10 sm:py-14 border-t crepus-t-border crepus-entrance crepus-e5 data-downloads-widget="true" data-downloads-state="loading"
			div flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5 sm:gap-6 mb-7 sm:mb-9
				div
					p text-xs font-semibold uppercase tracking-widest crepus-t-muted mb-3 sm:mb-4
						"Live crates.io signal"
					h2 text-lg sm:text-2xl font-semibold crepus-t-text mb-2
						"All Crepuscularity downloads"
					p text-sm crepus-t-muted m-0 max-w-2xl leading-relaxed
						"All-time and daily downloads across every published crate whose name starts with crepuscularity, fetched live from crates.io and rolled into one overall graph."
				a href="https://crates.io/search?q=crepuscularity" no-underline inline-flex items-center px-4 py-2 rounded-lg crepus-t-btn-ghost text-sm font-medium transition-colors hover:bg-[var(--cp-elevated)] self-start lg:self-auto rel="noopener noreferrer" target="_blank"
					"Open crates.io"
			div downloads-panel rounded-xl p-5 sm:p-6 lg:p-7 crepus-t-card
				div grid gap-4 sm:grid-cols-3 mb-6
					div downloads-stat
						span text-xs font-semibold uppercase tracking-widest crepus-t-muted
							"Total"
