}
@keyframes crepus-rise {
  from { opacity: 0; transform: translateY(24px) scale(0.98); filter: blur(12px); }
  to { opacity: 1; transform: none; filter: blur(0); }
}
.crepus-entrance { animation: crepus-rise 1s cubic-bezier(0.16, 1, 0.3, 1) both; }
.crepus-e1 { animation-delay: 0.05s; }
.crepus-e2 { animation-delay: 0.11s; }
.crepus-e3 { animation-delay: 0.17s; }
.crepus-e4 { animation-delay: 0.23s; }
