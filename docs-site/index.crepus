						span text-xs font-semibold uppercase tracking-widest crepus-t-muted
							"Recent"
						strong text-3xl sm:text-4xl font-semibold crepus-t-text leading-none data-downloads-recent="true"
							"…"
					div downloads-stat
						span text-xs font-semibold uppercase tracking-widest crepus-t-muted
							"Crates"
						strong text-3xl sm:text-4xl font-semibold crepus-t-text leading-none data-downloads-crates="true"
							"…"
				div grid lg:grid-cols-[minmax(0,1fr)_minmax(260px,360px)] gap-5 sm:gap-6 items-stretch
					div downloads-graph-shell rounded-lg border crepus-t-border overflow-hidden min-h-[260px]
						div downloads-graph-header flex items-center justify-between gap-3 px-4 py-3 border-b crepus-t-border
							span text-xs font-semibold uppercase tracking-widest crepus-t-muted
								"Cumulative history"
							span text-xs crepus-t-muted data-downloads-peak="true"
								"Loading"
						div downloads-graph p-3 sm:p-4 data-downloads-graph="true"
							div downloads-skeleton
					div downloads-crate-list rounded-lg border crepus-t-border overflow-hidden data-downloads-list="true"
						div downloads-crate-row
							span
								strong
									"Loading crates"
								small
									"crates.io"
							b
								"…"
				p text-xs crepus-t-muted mt-5 mb-0 data-downloads-status="true"
					"Loading live crates.io download history…"


