  display: inline-block;
  transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
}
.guide-link:hover .guide-link-arrow,
.guide-link:focus-visible .guide-link-arrow {
  transform: translateX(0.22rem);
}
