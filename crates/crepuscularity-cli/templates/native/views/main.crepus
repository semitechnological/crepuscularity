div flex flex-col gap-4 p-6 pt-[112px] pb-[40px] w-full h-full bg-[#101624]
  div flex flex-col gap-2
    span text-xs text-[#c7d2fe]
      "Crepus Mobile"
    span text-2xl font-bold text-[#ffffff]
      "Launch Control"
    span text-sm text-[#e5e7eb]
      "A full-screen SwiftUI and Compose app rendered from one .crepus file."
  div flex flex-row gap-4
    div flex flex-col gap-2 p-4 bg-[#2563eb] rounded-lg
      span text-xs text-[#dbeafe]
        "Build"
      span text-2xl font-bold text-[#ffffff]
        "Ready"
    div flex flex-col gap-2 p-4 bg-[#059669] rounded-lg
      span text-xs text-[#d1fae5]
        "Runtime"
      span text-2xl font-bold text-[#ffffff]
        "Live"
  div flex flex-col gap-2 p-4 bg-[#1f2937] rounded-lg
    span text-sm font-semibold text-[#ffffff]
      "Today"
    span text-sm text-[#e5e7eb]
      "Edit views/main.crepus and run crepus mobile dev for hot reload."
    span text-sm text-[#e5e7eb]
      "Ship one View IR tree to iOS and Android."
  div flex flex-row gap-4
    button @click="sync" bg-[#ffffff] rounded-lg p-4
      "Sync"
    button @click="preview" bg-[#334155] rounded-lg p-4
      "Preview"
