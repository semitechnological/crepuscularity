{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["target/crepus-out/**", ".crepus-cache/**"],
      "inputs": [
        "**/*.rs",
        "**/*.crepus",
        "**/Cargo.toml",
        "**/crepus.toml",
        "Cargo.lock"
      ],
      "cache": true
    },
    "build:web": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "target/wasm32-unknown-unknown/**",
        ".crepus-cache/**"
      ],
      "inputs": [
        "**/*.rs",
        "**/*.crepus",
        "**/Cargo.toml",
        "**/crepus.toml",
        "**/site.json",
        "Cargo.lock"
      ],
      "cache": true
    },
    "build:webext": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".crepus-cache/**"
      ],
      "inputs": [
        "**/*.rs",
        "**/*.crepus",
        "**/Cargo.toml",
        "**/crepus.toml",
        "Cargo.lock"
      ],
      "cache": true
    },
    "build:docs": {
      "dependsOn": ["build:web"],
      "outputs": [
        "docs-site/dist/**",
        ".crepus-cache/**"
      ],
      "inputs": [
        "docs/**/*.md",
        "docs-site/**",
        "**/Cargo.toml",
        "Cargo.lock"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "**/*.rs",
        "**/*.crepus",
        "**/Cargo.toml",
        "Cargo.lock"
      ],
      "cache": false
    },
    "test:hydration": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "crates/crepuscularity-web/**",
        "crates/crepuscularity-core/**",
        "Cargo.lock"
      ],
      "cache": false
    },
    "lint": {
      "dependsOn": [],
      "outputs": [],
      "inputs": [
        "**/*.rs",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "cache": false
    },
    "fmt": {
      "dependsOn": [],
      "outputs": [],
      "inputs": [
        "**/*.rs",
        "**/*.crepus",
        "**/*.md"
      ],
      "cache": false
    },
    "ci": {
      "dependsOn": ["fmt", "lint", "test"],
      "outputs": [],
      "cache": false
    }
  },
  "globalDependencies": [
    "rust-toolchain.toml",
    ".github/workflows/*.yml"
  ]
}
