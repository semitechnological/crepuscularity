{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["bun"],
    "paths": {
      "moonshine": ["../moonshine/src/index.ts"],
      "moonshine/*": ["../moonshine/src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
