--- Faq
$: default title = "Frequently Asked Questions"
section class="py-24 px-6 lg:px-8 bg-[var(--surface)]"
  div class="mx-auto max-w-3xl"
    if {eyebrow}
      p class="mb-4 text-center text-sm font-semibold uppercase tracking-[0.24em] text-[var(--accent)]"
        {eyebrow}
    # Section title
    if {title}
      h2 class="text-3xl font-bold tracking-tight text-[var(--text)] sm:text-4xl text-center mb-6"
        {title}
    if {description}
      p class="mx-auto mb-16 max-w-3xl text-center text-lg text-[var(--muted)]"
        {description}
    
    # FAQ items - using details/summary for native expand/collapse
    div class="space-y-4"
      for item in {items}
        details class="group rounded-lg border border-[var(--border)] bg-[var(--surface)]"
          summary class="flex cursor-pointer items-center justify-between px-6 py-4 text-[var(--text)] font-medium hover:bg-[var(--border)]/10 transition-colors"
            span
              {item.question}
            # Chevron icon (rotates when open)
            svg class="h-5 w-5 text-[var(--muted)] group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"
              path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"
          div class="px-6 pb-4 text-[var(--muted)] leading-relaxed"
            {item.answer}
