--- ShopifyCollection
$: default title = ""
$: default collectionHandle = ""
$: default limit = 8
section class="py-24 px-6 lg:px-8 bg-[var(--surface)]"
  div class="mx-auto max-w-7xl"
    if {eyebrow}
      p class="text-center text-sm font-semibold uppercase tracking-[0.24em] text-[var(--accent)]"
        {eyebrow}
    # Section title
    if {title}
      h2 class="text-3xl font-bold tracking-tight text-[var(--text)] sm:text-4xl text-center mb-6"
        {title}
    if {description}
      p class="mx-auto mb-16 max-w-3xl text-center text-lg text-[var(--muted)]"
        {description}
    
    # Products grid
    div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4"
      for product in {products}
        a href="/products/{product.handle}" class="group"
          div class="relative overflow-hidden rounded-lg border border-[var(--border)] bg-[var(--surface)]"
            # Product image
            if {product.image}
              div class="aspect-square overflow-hidden"
                img src={product.image} alt={product.title} class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
            else
              div class="aspect-square bg-[var(--border)]/20 flex items-center justify-center"
                span class="text-[var(--muted)]"
                  "No image"
            
            # Product info
            div class="p-4"
              h3 class="text-[var(--text)] font-medium group-hover:text-[var(--accent)] transition-colors"
                {product.title}
              
              div class="mt-2 flex items-center gap-2"
                span class="text-[var(--text)] font-semibold"
                  {product.price}
                if {product.compareAtPrice}
                  span class="text-[var(--muted)] line-through text-sm"
                    {product.compareAtPrice}
