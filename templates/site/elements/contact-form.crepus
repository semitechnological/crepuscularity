--- ContactForm
$: default title = "Get In Touch"
$: default description = ""
$: default submitLabel = "Send Message"
$: default endpoint = ""
$: default method = "POST"
section id="contact" class="py-24 px-6 lg:px-8 bg-[var(--surface)]"
  div class="mx-auto max-w-2xl"
    # Section header
    div class="text-center mb-12"
      if {eyebrow}
        p class="mb-4 text-sm font-semibold uppercase tracking-[0.24em] text-[var(--accent)]"
          {eyebrow}
      if {title}
        h2 class="text-3xl font-bold tracking-tight text-[var(--text)] sm:text-4xl"
          {title}
      if {description}
        p class="mt-4 text-lg text-[var(--muted)]"
          {description}
    
    # Form
    form action={endpoint} method={method} data-form-id={formId} class="space-y-6"
      for field in {fields}
        div
          label for={name} class="block text-sm font-medium text-[var(--text)] mb-2"
            {label}
            if {required}
              span class="text-red-500 ml-1"
                "*"
          
          if {type == "textarea"}
            textarea id={name} name={name} rows="4" placeholder={placeholder} class="w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-[var(--text)] placeholder-[var(--muted)] focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)] transition-colors"
          else if {type == "select"}
            select id={name} name={name} class="w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-[var(--text)] focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)] transition-colors"
              option value=""
                "Select..."
              for option in {options}
                option value={value}
                  {label}
          else
            input type={type} id={name} name={name} placeholder={placeholder} class="w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-3 text-[var(--text)] placeholder-[var(--muted)] focus:border-[var(--accent)] focus:outline-none focus:ring-1 focus:ring-[var(--accent)] transition-colors"
      
      # Submit button
      div class="pt-4"
        button type="submit" class="w-full rounded-lg bg-[var(--accent)] px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-[var(--accent-soft)] transition-colors"
          {submitLabel}
      if {successMessage}
        p class="pt-4 text-center text-sm text-[var(--muted)]"
          {successMessage}
