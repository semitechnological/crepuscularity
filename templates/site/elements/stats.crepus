--- Stats
$: default title = ""
section class="py-24 px-6 lg:px-8 bg-[var(--accent)]/5"
  div class="mx-auto max-w-7xl"
    if {eyebrow}
      p class="text-center text-sm font-semibold uppercase tracking-[0.24em] text-[var(--accent)]"
        {eyebrow}
    # Section title
    if {title}
      h2 class="text-3xl font-bold tracking-tight text-[var(--text)] sm:text-4xl text-center mb-6"
        {title}
    if {description}
      p class="mx-auto mb-16 max-w-3xl text-center text-lg text-[var(--muted)]"
        {description}
    
    # Stats grid
    div class="grid grid-cols-2 gap-8 lg:grid-cols-4"
      for stat in {stats}
        div class="flex flex-col items-center text-center"
          # Value (large number)
          div class="text-4xl font-bold text-[var(--accent)] sm:text-5xl"
            {value}
          
          # Label
          div class="mt-2 text-lg font-medium text-[var(--text)]"
            {label}
          
          # Optional detail
          if {detail}
            div class="mt-1 text-sm text-[var(--muted)]"
              {detail}
