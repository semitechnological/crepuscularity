--- Services
$: default title = "Our Services"
section class="py-24 px-6 lg:px-8 bg-[var(--surface)]"
  div class="mx-auto max-w-7xl"
    if {eyebrow}
      p class="text-center text-sm font-semibold uppercase tracking-[0.24em] text-[var(--accent)]"
        {eyebrow}
    # Section title
    if {title}
      h2 class="text-3xl font-bold tracking-tight text-[var(--text)] sm:text-4xl text-center mb-6"
        {title}
    if {description}
      p class="mx-auto mb-16 max-w-3xl text-center text-lg text-[var(--muted)]"
        {description}
    
    # Services grid
    div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3"
      for service in {services}
        div class="relative rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-8 hover:border-[var(--accent)]/50 transition-colors"
          # Icon placeholder
          if {icon}
            div class="mb-4 text-[var(--accent)] text-3xl"
              {icon}
          else
            div class="mb-4 w-12 h-12 rounded-lg bg-[var(--accent)]/10 flex items-center justify-center"
              div class="w-6 h-6 rounded bg-[var(--accent)]"
          
          # Service title
          h3 class="text-xl font-semibold text-[var(--text)] mb-3"
            {title}
          
          # Service description
          if {description}
            p class="text-[var(--muted)] leading-relaxed"
              {description}
