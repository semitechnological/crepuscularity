--- Process
$: default title = "How It Works"
section class="py-24 px-6 lg:px-8 bg-[var(--accent)]/5"
  div class="mx-auto max-w-4xl"
    if {eyebrow}
      p class="mb-4 text-center text-sm font-semibold uppercase tracking-[0.24em] text-[var(--accent)]"
        {eyebrow}
    # Section title
    if {title}
      h2 class="text-3xl font-bold tracking-tight text-[var(--text)] sm:text-4xl text-center mb-6"
        {title}
    if {description}
      p class="mx-auto mb-16 max-w-3xl text-center text-lg text-[var(--muted)]"
        {description}
    
    # Steps
    div class="relative"
      # Vertical line connector
      div class="absolute left-6 top-0 bottom-0 w-0.5 bg-[var(--border)] hidden sm:block"
      
      div class="space-y-12"
        for step in {steps}
          div class="relative flex items-start gap-6"
            # Step number circle
            div class="relative z-10 flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-[var(--accent)] text-white font-bold text-lg"
              {step.number}
            
            # Step content
            div class="flex-1 pt-1"
              h3 class="text-xl font-semibold text-[var(--text)] mb-2"
                {step.title}
              if {step.description}
                p class="text-[var(--muted)] leading-relaxed"
                  {step.description}
