{
  "id": "toast",
  "category": "primitive",
  "title": "Toast",
  "description": "Transient notification surface (Spell / Base UI toast pattern).",
  "props": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "string"
    },
    "tone": {
      "type": "enum",
      "values": [
        "default",
        "success",
        "warning",
        "danger"
      ],
      "default": "default"
    },
    "durationMs": {
      "type": "number",
      "default": 4000
    }
  },
  "themes": [
    "dither-kit",
    "kumo",
    "night",
    "chalk",
    "aurora",
    "dawn",
    "zinc"
  ],
  "platforms": [
    "flutter",
    "svelte",
    "moonshine",
    "gpui",
    "crepus"
  ]
}
