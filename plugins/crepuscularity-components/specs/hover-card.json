{
  "id": "hover-card",
  "category": "primitive",
  "title": "Hover Card",
  "description": "Rich preview card shown on hover/focus (Base UI Hover Card).",
  "props": {
    "openDelayMs": {
      "type": "number",
      "default": 200
    },
    "closeDelayMs": {
      "type": "number",
      "default": 100
    },
    "side": {
      "type": "enum",
      "values": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "default": "bottom"
    }
  },
  "themes": [
    "dither-kit",
    "kumo",
    "night",
    "chalk",
    "aurora",
    "dawn",
    "zinc"
  ],
  "platforms": [
    "flutter",
    "svelte",
    "moonshine",
    "gpui",
    "crepus"
  ]
}
