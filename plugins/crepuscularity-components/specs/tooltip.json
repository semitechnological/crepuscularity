{
  "id": "tooltip",
  "category": "primitive",
  "title": "Tooltip",
  "description": "Hover/focus tooltip.",
  "props": {
    "content": {
      "type": "string",
      "required": true
    },
    "side": {
      "type": "enum",
      "values": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "default": "top"
    }
  },
  "themes": [
    "dither-kit",
    "kumo",
    "night",
    "chalk",
    "aurora"
  ],
  "platforms": [
    "flutter",
    "svelte",
    "moonshine",
    "gpui",
    "crepus"
  ]
}
