{
  "id": "gradient",
  "category": "primitive",
  "title": "Dither Gradient",
  "description": "Ordered-dither gradient plane for fills and backgrounds.",
  "props": {
    "color": {
      "type": "string",
      "default": "blue"
    },
    "variant": {
      "type": "enum",
      "values": [
        "gradient",
        "dotted",
        "hatched",
        "solid"
      ],
      "default": "gradient"
    },
    "direction": {
      "type": "enum",
      "values": [
        "vertical",
        "horizontal"
      ],
      "default": "vertical"
    }
  },
  "themes": [
    "dither-kit",
    "kumo",
    "night",
    "chalk",
    "aurora",
    "dawn",
    "zinc"
  ],
  "platforms": [
    "flutter",
    "svelte",
    "moonshine",
    "gpui",
    "crepus"
  ]
}
