{
  "id": "button",
  "category": "primitive",
  "title": "Button",
  "description": "Base UI–style pressable button with dither accent options.",
  "props": {
    "label": {
      "type": "string",
      "required": true
    },
    "variant": {
      "type": "enum",
      "values": [
        "solid",
        "outline",
        "ghost"
      ],
      "default": "solid"
    },
    "color": {
      "type": "string",
      "default": "blue"
    },
    "disabled": {
      "type": "boolean",
      "default": false
    }
  },
  "themes": [
    "dither-kit",
    "kumo",
    "night",
    "chalk",
    "aurora",
    "dawn",
    "zinc"
  ],
  "platforms": [
    "flutter",
    "svelte",
    "moonshine",
    "gpui",
    "crepus"
  ]
}
