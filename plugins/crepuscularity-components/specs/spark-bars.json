{
  "id": "spark-bars",
  "category": "chart",
  "title": "Spark Bars",
  "description": "Compact dithered column spark for a short numeric series.",
  "props": {
    "values": {
      "type": "number[]",
      "required": true
    },
    "color": {
      "type": "string",
      "default": "blue"
    },
    "variant": {
      "type": "enum",
      "values": [
        "gradient",
        "dotted",
        "hatched",
        "solid"
      ],
      "default": "gradient"
    },
    "height": {
      "type": "number",
      "default": 40
    },
    "gap": {
      "type": "number",
      "default": 1
    }
  },
  "themes": [
    "dither-kit",
    "kumo",
    "night",
    "chalk",
    "aurora",
    "dawn",
    "zinc"
  ],
  "platforms": [
    "flutter",
    "svelte",
    "moonshine",
    "gpui",
    "crepus"
  ]
}
