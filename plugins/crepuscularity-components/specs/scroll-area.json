{
  "id": "scroll-area",
  "category": "primitive",
  "title": "Scroll Area",
  "description": "Scrollable viewport with optional dithered scrollbars.",
  "props": {
    "orientation": {
      "type": "enum",
      "values": [
        "vertical",
        "horizontal",
        "both"
      ],
      "default": "vertical"
    },
    "type": {
      "type": "enum",
      "values": [
        "hover",
        "always",
        "scroll",
        "auto"
      ],
      "default": "hover"
    }
  },
  "themes": [
    "dither-kit",
    "kumo",
    "night",
    "chalk",
    "aurora",
    "dawn",
    "zinc"
  ],
  "platforms": [
    "flutter",
    "svelte",
    "moonshine",
    "gpui",
    "crepus"
  ]
}
