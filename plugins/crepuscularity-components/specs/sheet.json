    "open": {
      "type": "boolean",
      "default": false
    },
    "side": {
      "type": "enum",
      "values": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "default": "right"
    },
    "title": {
      "type": "string"
    }
  },
  "themes": [
    "dither-kit",
    "kumo",
    "night",
    "chalk",
    "aurora",
    "dawn",
    "zinc"
  ],
  "platforms": [
    "flutter",
    "svelte",
    "moonshine",
    "gpui",
    "crepus"
  ]
}
