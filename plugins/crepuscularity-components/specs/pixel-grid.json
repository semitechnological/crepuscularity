{
  "id": "pixel-grid",
  "category": "chart",
  "title": "Pixel Grid",
  "description": "Fixed-resolution Bayer pixel plane driven by density or mask data.",
  "props": {
    "cols": {
      "type": "number",
      "required": true
    },
    "rows": {
      "type": "number",
      "required": true
    },
    "densities": {
      "type": "number[]"
    },
    "color": {
      "type": "string",
      "default": "blue"
    },
    "cellSize": {
      "type": "number",
      "default": 2
    }
  },
  "themes": [
    "dither-kit",
    "kumo",
    "night",
    "chalk",
    "aurora",
    "dawn",
    "zinc"
  ],
  "platforms": [
    "flutter",
    "svelte",
    "moonshine",
    "gpui",
    "crepus"
  ]
}
